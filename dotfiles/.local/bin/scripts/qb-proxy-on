#!/bin/bash
# 开代理：把常驻实例（qb-server）的 content.proxy 指向本地代理（sing-box 的 mixed 入站 7890）。
#
# 运行时改动，所有窗口共享（proxy.init() 装的是进程级 QNetworkProxyFactory），
# QtWebEngine 几秒后应用新的连接（见 qutebrowser configdata.yml 的 content.proxy）。
# -t = 会话级，不写 autoconfig，进程退出自动回到 config.py 的默认值。

PROXY="http://127.0.0.1:7890"
PORT="${PROXY##*:}"

# sing-box 得先跑起来（它默认不开机自启），否则设了也是死端口
if ! pgrep -x sing-box >/dev/null; then
  echo "警告: sing-box 未运行，先起它：" >&2
  echo "  sing-box run -c ~/.config/sing-box/config.json &" >&2
fi

# 代理没跑就设了也指向死端口，先探一下：只警告，照常设置（可能马上就去起代理）
if ! (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
  echo "警告: 代理端口 $PORT 未监听，代理将指向死端口" >&2
fi

qb-open ":set -t content.proxy $PROXY"
echo "代理已开 → $PROXY"
