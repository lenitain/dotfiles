#!/bin/bash
# 用 umu-run + proton-cachyos 跑任意 Windows 程序, 每个程序一个独立前缀。
#
# 用法:
#   win <exe> [参数...]     自动建前缀: ~/.wine/apps/<exe名>
#   win -n <名字> <exe> ... 手动指定前缀名(几个 exe 共用一套环境时)
#   win -l <exe> ...        打开 Proton 日志, 落在 ~/proton.log
#   win -h                  显示本帮助
#
# 自动前缀名依次取: <exe名> → <有意义的上级目录名>-<exe名> → <exe名>-<路径哈希>,
# 挑第一个没被别的 exe 占用的(否则不同目录下的 game.exe 会挤进同一个前缀)。
# 选定后写 <前缀>.source 记住 exe 真实路径, 下次据此认回同一个前缀。
#
# 每个前缀可放一个同名 .env 覆盖环境变量, 例如 ~/.wine/apps/dusk-city.env:
#   GAMEID=umu-xxx    套用 protonfixes 里针对该程序的补丁
#   DXVK=0            关掉 DXVK, 改走 Wine 自带的 d3d11
#
# 覆盖 Proton 位置: WIN_PROTON=/path/to/proton-dir win ...
#
# protonfixes 会给每个前缀无条件装 FSR4 的 amdxcffx64.dll (首次要下 14MB)。
# 默认通过 PYTHONPATH 注入 FSR4_SHIM, 把它改回"显式要求才装"(上游语义)。
# 覆盖/禁用: WIN_FSR4_SHIM=... win ... 或 WIN_FSR4_SHIM= win ...

set -euo pipefail

PROTON="${WIN_PROTON:-/usr/share/steam/compatibilitytools.d/proton-cachyos-native}"
APPS_DIR="${WIN_APPS:-$HOME/.wine/apps}"
FSR4_SHIM="${WIN_FSR4_SHIM-$HOME/.local/share/protonfixes-nofsr4}"

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//p;}' "$0"
  exit "${1:-1}"
}

die() { echo "win: $*" >&2; exit 1; }

name="" log=0
while getopts "n:lh" opt; do
  case $opt in
    n) name=$OPTARG ;;
    l) log=1 ;;
    h) usage 0 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] || usage
command -v umu-run >/dev/null || die "找不到 umu-run (pacman -S umu-launcher)"
[ -d "$PROTON" ] || die "找不到 Proton: $PROTON (pacman -S proton-cachyos-native)"

exe=$(realpath -e -- "$1") || die "文件不存在: $1"
shift

mkdir -p "$APPS_DIR"

# 去掉 .exe、转小写、非字母数字折叠成 -
slug() {
  printf '%s' "$1" | sed 's/\.[Ee][Xx][Ee]$//' | tr '[:upper:]' '[:lower:]' \
    | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//'
}

# <前缀>.source 记录这个前缀绑定的 exe 真实路径, 用于认回同一个前缀
source_of() { if [ -f "$1.source" ]; then cat "$1.source"; fi; }

if [ -z "$name" ]; then
  base=$(slug "$(basename "$exe")")
  [ -n "$base" ] || base=app

  # 上级目录名: 跳过 bin/win64/x64 之类没有辨识度的壳目录
  dir=$(dirname "$exe")
  parent=""
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    d=$(slug "$(basename "$dir")")
    case $d in
      ""|bin|bin32|bin64|win32|win64|x86|x64|data|files|app|release|debug|game|games|common|steam|steamapps) ;;
      *) parent=$d; break ;;
    esac
    dir=$(dirname "$dir")
  done

  hash=""
  if command -v md5sum >/dev/null; then
    hash=$(printf '%s' "$exe" | md5sum | cut -c1-6)
  fi

  candidates=("$base")
  if [ -n "$parent" ] && [ "$parent" != "$base" ]; then candidates+=("$parent-$base"); fi
  if [ -n "$hash" ]; then candidates+=("$base-$hash"); fi

  for cand in "${candidates[@]}"; do
    p="$APPS_DIR/$cand"
    src=$(source_of "$p")
    if [ -z "$src" ]; then
      # 没有来源记录: 目录已存在说明是老版脚本建的, 认领它并补上记录,
      # 免得以后被同名 exe 抢走
      if [ -e "$p" ]; then
        printf '%s\n' "$exe" >"$p.source"
        echo "win: 前缀 $cand 没有来源记录, 认领为 $exe (不对就用 -n 指定)" >&2
      fi
      name=$cand; break
    fi
    if [ "$src" = "$exe" ]; then name=$cand; break; fi
  done
  [ -n "$name" ] || die "前缀名 $base 已被同名的其它 exe 占住, 用 -n <名字> 指定"
  [ "$name" = "$base" ] || echo "win: $base 已被占用, 改用前缀 $name" >&2
fi

printf '%s\n' "$exe" >"$APPS_DIR/$name.source"

env_file="$APPS_DIR/$name.env"
if [ -f "$env_file" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
fi

env_args=(WINEPREFIX="$APPS_DIR/$name" PROTONPATH="$PROTON")
if [ -d "$FSR4_SHIM" ]; then
  env_args+=(PYTHONPATH="$FSR4_SHIM${PYTHONPATH:+:$PYTHONPATH}")
fi
if [ "$log" = 1 ]; then env_args+=(PROTON_LOG=1); fi

exec env "${env_args[@]}" umu-run "$exe" "$@"
