# Background
# 与 niri startup.kdl 里 swaybg 使用的壁纸保持一致
# swaylock 用 wordexp 展开路径，$HOME 可用
image=$HOME/.local/share/wallpapers/starry-night-sky.png
scaling=fill

# Everforest Dark Medium colors
color=000000
# 圆环内部完全透明（alpha=00），透出壁纸
inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000

ring-color=7FBBB3
ring-clear-color=7FBBB3
ring-caps-lock-color=7FBBB3
ring-ver-color=7FBBB3
ring-wrong-color=E67E80

key-hl-color=A7C080
bs-hl-color=A7C080

line-color=4f585e
line-clear-color=4f585e
line-caps-lock-color=4f585e
line-ver-color=4f585e
line-wrong-color=4f585e

separator-color=00000000

text-color=d3c6aa
text-clear-color=d3c6aa
text-caps-lock-color=d3c6aa
text-ver-color=d3c6aa
text-wrong-color=e67e80

# Font
font=Noto Sans
# 固定字号；留空则默认取 indicator-radius/3
font-size=128

# Indicator
# 默认空闲时圆环会隐藏，这里让它常驻
indicator-idle-visible
# 尺寸单位是逻辑像素，实际渲染时会再乘以输出缩放（当前 1.25）
# radius 是圆环中线半径，thickness 是环的宽度
# 外径 = 2 * (radius + thickness) = 576，缩放后约 720 设备像素
indicator-radius=256
indicator-thickness=24
