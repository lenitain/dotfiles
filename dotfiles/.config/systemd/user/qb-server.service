[Unit]
Description=qutebrowser 常驻 server（--nowindow + IPC socket）
Documentation=file:%h/.local/bin/scripts/qb-server
# 由 graphical-session.target 拉起（WantedBy 在末尾）。After 不能省：WAYLAND_DISPLAY
# 与 Wayland socket 路径要等 niri 发 READY（也就是 target 到达）才进 user manager 的
# 环境，早于 target 启动的 Qt/Wayland 程序拿到的是一份没有 display 的环境。
After=graphical-session.target
# 会话结束（niri-session 会 `systemctl --user start niri-shutdown.target`，
# 该 target 与 graphical-session.target 冲突）时跟着一起停。
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/scripts/qb-server --nowindow -R

# 退出后保持停止：qb-open ':quit' 之后要一直死着，直到下次手动启动或下次登录。
Restart=no

# 不要动 KillMode。默认的 control-group 是「主进程一退就扫掉 cgroup 里剩下的
# 进程」这条保证的来源；改成 process / mixed 会退化成普通父子关系，
# QtWebEngine 卡住的子进程会留下来。
# 这是本单元存在的核心理由 —— 差别只在于 cgroup 有没有 MainPID 跟踪：
#   裸 setsid              → 孤儿残留
#   niri 的 spawn-sh scope  → 孤儿残留（scope 的 MainPID 为空，要 cgroup 空了才算 inactive）
#   systemd service（本例） → 孤儿被扫掉，正常退出和 kill -9 都扫
# 所以启动方式必须走这个 service，别改回 niri 的 spawn-sh。
KillMode=control-group

# 给 qutebrowser 一点时间正常收尾（关标签、存 session），超时才 SIGKILL。
# 注意：TimeoutStopSec 之后 systemd 发的 SIGKILL 是发给 cgroup 全体，不是只发主进程。
TimeoutStopSec=10

# qutebrowser 自己接管了 SIGTERM/SIGINT，会优雅收尾然后以 128+信号 退出
#   （SIGTERM→143，SIGINT→130，journal 里能看到 "SIGINT/SIGTERM received, shutting down!"）
# 对 systemd 来说这是非零退出码，会把单元记成 failed —— 可明明是我们让它停的，
# 而且它退得很干净。所以这两个码要显式算作成功，否则每次 `systemctl --user stop`
# 都留一个红着的 failed 单元。
# 不要把 137(128+9, SIGKILL) 也算进来：那说明是被强杀的，failed 才正确。
SuccessExitStatus=130 143

# 日志走 journal：journalctl --user -u qb-server -f
StandardOutput=journal
StandardError=journal

[Install]
# 等价于旧版 niri startup.kdl 里那句 `systemctl --user start qb-server`：
# graphical-session.target 同样是 niri 就绪之后才到达，但少一个瞬态 scope，
# 而且 is-enabled 能如实反映出它会自启。target 每次登录只到达一次，所以
# stop 之后不会再被自动拉起 —— 与 Restart=no 的语义一致。
WantedBy=graphical-session.target
