# mako — Everforest Dark Medium（色值对应 ~/.palette/everforest.md）

# ---------- 交互 ----------
# 左键：关掉这一条 / 右键：关掉这一组
on-button-left=dismiss
on-button-right=dismiss-group

# ---------- 行为 ----------
font=Noto Sans CJK SC 16
max-visible=5
group-by=app-name
default-timeout=5000

# ---------- 布局 ----------
width=420
height=160
padding=14
margin=12
border-size=2
border-radius=12
max-icon-size=56
icon-border-radius=8

# ---------- 定位 ----------
layer=overlay
anchor=top-right

# ---------- 配色 ----------
background-color=#3D484D
text-color=#D3C6AA
border-color=#859289
progress-color=over #7FBBB3
