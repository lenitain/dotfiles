#!/usr/bin/luajit
-- popup-wrapper - 点一下开，再点一下关
--
-- 用法: popup-wrapper <命令> [参数…]
--
-- 「窗开没开」直接问 niri：连 $NIRI_SOCKET 发一行 `"Windows"`，拿回一行 JSON。
-- 协议就是 niri msg 用的那套，所以不再起 bash/jq/niri msg 三个进程
-- （实测 27ms → 4ms）。
--
-- app_id 取命令名。GTK 应用发的是反向 DNS 的 app_id，而最后一段正好是二进制名，
-- 所以两种都得认：
--     gsimplecal  →  'gsimplecal'                  直接相等
--     pavucontrol →  'org.pulseaudio.pavucontrol'  取最后一段
-- 只做相等匹配会漏掉 pavucontrol 这类名字，点图标只会不断重开，永远关不掉。
--
-- 关窗和启动都走 niri 的 action：启动用 Spawn，由 niri 自己 exec，进程不再挂在
-- 本脚本下面（脚本退出后不会被连带回收）。

local ffi = require("ffi")

ffi.cdef [[
int socket(int, int, int);
int connect(int, const void *, unsigned int);
long write(int, const char *, unsigned long);
long read(int, char *, unsigned long);
int close(int);

struct sockaddr_un {
    unsigned short sun_family;
    char sun_path[108];
};
]]

local AF_UNIX, SOCK_STREAM = 1, 1

local function die(msg, code)
    io.stderr:write("popup-wrapper: ", msg, "\n")
    os.exit(code or 1)
end

---------------------------------------------------------------- JSON 读取
-- 只覆盖 niri IPC 会发出的那部分 JSON：对象、数组、字符串、数字、true/false/null。
local function utf8_char(code)
    if code < 0x80 then return string.char(code) end
    if code < 0x800 then
        return string.char(0xC0 + math.floor(code / 0x40), 0x80 + code % 0x40)
    end
    return string.char(
        0xE0 + math.floor(code / 0x1000),
        0x80 + math.floor(code / 0x40) % 0x40,
        0x80 + code % 0x40
    )
end

local function decode_json(text)
    local pos, len = 1, #text
    local value -- 前向声明，对象/数组要递归

    local function fail()
        error("bad json at " .. pos, 0)
    end

    local function skip_space()
        while pos <= len do
            local byte = text:byte(pos)
            if byte == 0x20 or byte == 0x09 or byte == 0x0A or byte == 0x0D then
                pos = pos + 1
            else
                break
            end
        end
    end

    local escapes = {
        ['"'] = '"', ['\\'] = '\\', ['/'] = '/',
        b = "\b", f = "\f", n = "\n", r = "\r", t = "\t",
    }

    local function parse_string()
        pos = pos + 1
        local parts, start = {}, pos
        while pos <= len do
            local byte = text:byte(pos)
            if byte == 0x22 then
                parts[#parts + 1] = text:sub(start, pos - 1)
                pos = pos + 1
                return table.concat(parts)
            elseif byte == 0x5C then
                parts[#parts + 1] = text:sub(start, pos - 1)
                local esc = text:sub(pos + 1, pos + 1)
                if esc == "u" then
                    parts[#parts + 1] = utf8_char(tonumber(text:sub(pos + 2, pos + 5), 16) or 0)
                    pos = pos + 6
                else
                    parts[#parts + 1] = escapes[esc] or esc
                    pos = pos + 2
                end
                start = pos
            else
                pos = pos + 1
            end
        end
        fail()
    end

    local function parse_number()
        local num = text:match("^-?%d+%.?%d*[eE]?[-+]?%d*", pos)
        if not num or num == "" then fail() end
        pos = pos + #num
        return tonumber(num)
    end

    value = function()
        skip_space()
        local char = text:sub(pos, pos)
        if char == "{" then
            pos = pos + 1
            local obj = {}
            skip_space()
            if text:sub(pos, pos) == "}" then
                pos = pos + 1
                return obj
            end
            while true do
                skip_space()
                local key = parse_string()
                skip_space()
                if text:sub(pos, pos) ~= ":" then fail() end
                pos = pos + 1
                obj[key] = value()
                skip_space()
                local sep = text:sub(pos, pos)
                pos = pos + 1
                if sep == "}" then return obj end
                if sep ~= "," then fail() end
            end
        elseif char == "[" then
            pos = pos + 1
            local arr = {}
            skip_space()
            if text:sub(pos, pos) == "]" then
                pos = pos + 1
                return arr
            end
            while true do
                arr[#arr + 1] = value()
                skip_space()
                local sep = text:sub(pos, pos)
                pos = pos + 1
                if sep == "]" then return arr end
                if sep ~= "," then fail() end
            end
        elseif char == '"' then
            return parse_string()
        elseif char == "t" then
            pos = pos + 4
            return true
        elseif char == "f" then
            pos = pos + 5
            return false
        elseif char == "n" then
            pos = pos + 4
            return nil
        end
        return parse_number()
    end

    return value()
end

---------------------------------------------------------------- json 输出
local function json_string(str)
    local escapes = {
        ['"'] = '\\"', ['\\'] = '\\\\', ["\n"] = '\\n', ["\r"] = '\\r', ["\t"] = '\\t',
    }
    return '"' .. str:gsub("[%z\1-\31\\\"]", function(char)
        return escapes[char] or string.format("\\u%04x", char:byte())
    end) .. '"'
end

---------------------------------------------------------------- IPC
local socket_path = os.getenv("NIRI_SOCKET")
if not socket_path then die("NIRI_SOCKET 未设置，不在 niri 会话里？") end
if #socket_path >= 108 then die("NIRI_SOCKET 路径太长") end

local fd = ffi.C.socket(AF_UNIX, SOCK_STREAM, 0)
if fd < 0 then die("socket() 失败") end

local addr = ffi.new("struct sockaddr_un")
addr.sun_family = AF_UNIX
ffi.copy(addr.sun_path, socket_path) -- 结构体零初始化，结尾自带 \0
local addr_len = ffi.offsetof("struct sockaddr_un", "sun_path") + #socket_path + 1
if ffi.C.connect(fd, ffi.cast("const void *", addr), addr_len) ~= 0 then
    ffi.C.close(fd)
    die("connect " .. socket_path .. " 失败")
end

local buf = ffi.new("char[65536]")

-- 发一行 JSON 请求，读回一行 JSON 回复
local function request(json)
    local line = json .. "\n"
    if ffi.C.write(fd, line, #line) ~= #line then die("write 失败") end

    local chunks = {}
    while true do
        local n = ffi.C.read(fd, buf, ffi.sizeof(buf))
        if n <= 0 then break end
        local chunk = ffi.string(buf, n)
        local nl = chunk:find("\n", 1, true)
        if nl then
            chunks[#chunks + 1] = chunk:sub(1, nl - 1)
            return table.concat(chunks)
        end
        chunks[#chunks + 1] = chunk
    end
    die("读取回复失败")
end

---------------------------------------------------------------- 主流程
if not arg[1] then die("用法: popup-wrapper <命令> [参数…]", 2) end

local app_id = arg[1]:match("([^/]+)$") or arg[1]

local reply = decode_json(request('"Windows"'))
local windows = reply and reply.Ok and reply.Ok.Windows
if type(windows) ~= "table" then die("解析 Windows 回复失败") end

local target
for _, window in ipairs(windows) do
    local id = window.app_id
    if type(id) == "string" and (id == app_id or id:match("[^.]+$") == app_id) then
        target = window
        break
    end
end

if target then
    request(string.format('{"Action":{"CloseWindow":{"id":%d}}}', target.id))
else
    local parts = {}
    for i = 1, #arg do
        parts[#parts + 1] = json_string(arg[i])
    end
    request('{"Action":{"Spawn":{"command":[' .. table.concat(parts, ",") .. ']}}}')
end

ffi.C.close(fd)
