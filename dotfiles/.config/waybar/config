{
    "layer": "top",

    // 固定条高 30px：内容区就是整条 bar，hover/active 底色铺满 30px
    // 并贴住上下边缘，不留缝。GTK 下 window#waybar 的 CSS min-height
    // 只会让首次 configure 冲到 38 再落回内容高，管不住最终高度；
    // 这里用 waybar 的 height 选项钉死。
    "height": 30,

    // 只在 niri overview 打开时出现：常驻进程、默认不可见，登录时不闪一下。
    // 信号被改成幂等的 show / hide（默认是 toggle / reload），由
    // ~/.config/niri/scripts/waybar-overview 按 overview 状态直接下发，
    // 脚本不用自己记可见性，waybar 重开也不会弄反。
    // 代价：改这里的 config 只能 restart（~/.config/waybar/reload-config.sh）。
    "start_hidden": true,
    "on-sigusr1": "show",
    "on-sigusr2": "hide",

    // 不要 exclusive zone（strut）。bar 只在 overview 里出现，若要 strut，
    // 开/关 overview 时工作区高度一变，所有平铺窗口就跟着重排 30px
    // （终端重排文字）；不要 strut，窗口始终铺满整块屏幕，一次都不重排。
    // 代价：overview 的缩略图会从 bar 底下穿过。bar 底色和 overview
    // backdrop-color 同为 #232A2E，这条带子看起来就是 backdrop 的一部分。
    "exclusive": false,

    // 工作区数字独占中栏，fixed-center 把它钉在屏幕正中
    // （实测徽章中心 767.6，屏幕中心 768，差在 0.5px 舍入内）。
    // 代价：左右两组各只分到一半宽度，左栏的窗口标题会更早 ellipsize。
    "fixed-center": true,

    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
        "niri/workspaces#taskbar",
        "niri/window"
    ],

    "modules-center": [
        "niri/workspaces#numbers"
    ],

    "modules-right": [
        "tray",
        "custom/idle-inhibit",
        "battery",
        "pulseaudio",
        "clock"
    ]
}
