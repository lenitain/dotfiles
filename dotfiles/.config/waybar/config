{
    "layer": "top",

    // 工作区数字独占中栏，fixed-center 把它钉在屏幕正中
    // （实测徽章中心 767.6，屏幕中心 768，差在 0.5px 舍入内）。
    // 代价：左右两组各只分到一半宽度，左栏的窗口标题会更早 ellipsize。
    "fixed-center": true,

    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
        "niri/workspaces#taskbar",
        "niri/window"
    ],

    "modules-center": [
        "niri/workspaces#numbers"
    ],

    "modules-right": [
        "tray",
        "custom/idle-inhibit",
        "battery",
        "pulseaudio",
        "clock"
    ]
}
