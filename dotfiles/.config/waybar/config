{
    "layer": "top",

    // 固定条高 32px = 30px 内容高 + 上下各 1px 空隙。GTK 下 window#waybar 的
    // CSS min-height 只会让首次 configure 冲到 38 再落回内容高，管不住最终
    // 高度；这里用 waybar 的 height 选项钉死，hover/active 底色才能正好铺满
    // 30px 内容高，又不贴在屏幕顶边和栏底上。
    "height": 32,

    // 工作区数字独占中栏，fixed-center 把它钉在屏幕正中
    // （实测徽章中心 767.6，屏幕中心 768，差在 0.5px 舍入内）。
    // 代价：左右两组各只分到一半宽度，左栏的窗口标题会更早 ellipsize。
    "fixed-center": true,

    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
        "niri/workspaces#taskbar",
        "niri/window"
    ],

    "modules-center": [
        "niri/workspaces#numbers"
    ],

    "modules-right": [
        "tray",
        "custom/idle-inhibit",
        "battery",
        "pulseaudio",
        "clock"
    ]
}
