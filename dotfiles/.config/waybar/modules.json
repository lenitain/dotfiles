{
  // Workspaces
  "niri/workspaces": {
    "on-click": "activate"
  },

  // Idle Inhibit (阻止自动锁屏)
  "custom/idle-inhibit": {
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/idle-inhibit.sh",
    "align": 1,
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/idle-inhibit.sh toggle"
  },

  // 中心模块：列指示器（colpos.py 事件驱动常驻进程）
  // expand 让模块在 center 盒子内撑满；默认 fixed-center 下 GTK 把 center 盒子
  // 宽度钳制在左右簇之间（不推挤两侧），短文本居中屏幕中心。
  // max-length 是启用 GTK label ellipsize 的唯一开关（waybar 没有布尔选项）：
  // 999999 不会被任何文本触及，实际截断点 100% 由 GTK 布局决定（碰撞点省略）
  "custom/colpos": {
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/colpos.py",
    "hide-empty-text": true,
    "align": 0.5,
    "tooltip": true,
    "expand": true,
    "max-length": 999999
  },

  // System tray
  // spacing 必须是 0：图标间距改由 style.css 给 image 加 padding 提供，
  // 这样间距属于图标自己（可点、可 hover），整条 tray 没有点不中的空档。
  "tray": {
    "icon-size": 21,
    "spacing": 0
  },

  // Clock
  "clock": {
    "align": 1,
    "format": "{:%H : %M}",
    "on-click": "gsimplecal",
    "tooltip": true,
    "tooltip-format": "{:%Y - %m - %d %A}"
  },

  // Battery
  "battery": {
    "align": 1,
    "on-click": "~/.config/waybar/scripts/battery-info.sh",
    "states": {
      "warning": 30,
      "critical": 15
    },
    // 放电：MD 电池电量图标（5 档与插头同宽 11px → 插电/放电右边缘恒定）。
    // 分隔由 CSS 内边距负责（16px 等间距），不再需要尾随空格。
    "format": "{capacity}% {icon}",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"],
    // 插电 / 充电 / 满电 / not-charging：绿色插头（span 只包图标，数字不变色）。
    // 必须覆盖 format-not-charging，否则该状态回落到 format 显示电池 → 闪烁。
    "format-charging": "{capacity}% <span color='#a7c080'>󰂄</span>",
    "format-full": "{capacity}% <span color='#a7c080'>󰂄</span>",
    "format-not-charging": "{capacity}% <span color='#a7c080'>󰂄</span>",
    "format-plugged": "{capacity}% <span color='#a7c080'>󰂄</span>"
  },

  // Pulseaudio（单模块，FA 大图标，数字在左）
  "pulseaudio": {
    "align": 1,
    "format": "{volume}% {icon}",
    "format-muted": "<span color='#e67e80'>{icon}</span>",
    // 音量为 0（即使未标记静音）：照常显示数字，仅图标换成白色 
    "states": {
      "mute": 0
    },
    "format-mute": "{volume}% ",
    "format-icons": {
      "default": "",
      "default-muted": ""
    },
    "on-click": "pavucontrol",
    "on-click-right": "pavucontrol"
  },

  // Bluetooth
  "bluetooth": {
    "align": 1,
    "format": "{status} ",
    "format-disabled": "",
    "format-off": "",
    "on-click": "blueman-manager",
    "format-no-controller": ""
  }
}
