// Layout configuration
layout {
    gaps 4
    center-focused-column "never"
    always-center-single-column
    empty-workspace-above-first
    background-color "#343F44"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
    }
    focus-ring {
        width 1
    }
    border {
        on
        width 1
    }
    struts {}
}

// Animations - all disabled
animations {
    off
}

// Window rules
window-rule {
    match app-id=r#"qutebrowser$"#
    open-maximized-to-edges true
}
// 必须排在通用 qutebrowser 规则之后：
// 窗口规则按顺序解析、后到覆盖先到，显式撤销 maximized 才能让 PiP 真正浮动
window-rule {
    match app-id=r#"qutebrowser$"# title="^Picture-in-Picture$"
    open-floating true
    open-maximized-to-edges false
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}
window-rule {
    match title="^(Open|Save|Choose|Select|Preferences|About|Properties|File Upload|Create New Folder)"
    open-floating true
}
window-rule {
    match title="^(打开|保存|选择|另存为|属性|上传)"
    open-floating true
}
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Hotkey overlay
hotkey-overlay {
    skip-at-startup
}

// Overview
overview {
    zoom 0.3
    backdrop-color "#232A2E"
}

