// Niri configuration for CachyOS
// For documentation and full reference, see: https://github.com/YaLTeR/niri/wiki

// Include configuration files
include "binds.kdl"
include "appearance.kdl"
include "colors.kdl"
include "environment.kdl"
include "input.kdl"
include "outputs.kdl"
include "startup.kdl"
include "switch-events.kdl"

// 截图保存位置
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d %H-%M-%S.png"

// 带缩略图的 Alt+Tab 切换窗口功能
recent-windows {
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        // active-color / urgent-color 在 colors.kdl 中定义
        // 缩略图背景内间距
        padding 30
        // 缩略图的背景圆角
        corner-radius 0
    }

    // 设置缩略图大小
    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        // scope 可以设置显示的窗口是当前工作区的、还是当前显示器的、或者显示全部窗口
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        // grave 是波浪键，显示当前应用的所有窗口
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}
