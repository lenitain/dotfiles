// Niri configuration for CachyOS
// For documentation and full reference, see: https://github.com/YaLTeR/niri/wiki

// Include configuration files
// Each include is optional: a missing file logs a warning instead of failing the whole config.
// Other errors (e.g. invalid syntax in an existing file) still fail as usual.
include optional=true "binds.kdl"
include optional=true "appearance.kdl"
include optional=true "colors.kdl"
include optional=true "environment.kdl"
include optional=true "input.kdl"
include optional=true "output.kdl"
include optional=true "startup.kdl"
include optional=true "switch-events.kdl"
include optional=true "animations.kdl"
