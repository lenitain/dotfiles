// 全局禁用过头效果：将 damping-ratio 设为 1.0（临界阻尼）
animations {
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.01
    }

    window-open {
        off
    }

    window-close {
        off
    }

    slowdown 0.5
}
