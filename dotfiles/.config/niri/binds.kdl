binds {
    // System
    MOD+SHIFT+ESCAPE {
        show-hotkey-overlay
    }
    // 状态面板：fuzzel 快照（录制 / 熄屏抑制 / 输入法 / 电量 / 亮度 / 音量 / 工作区 /
    // 时钟）。录制一行在面板最上面：回车即开始/停止录制。
    // 再按一次是刷新，因为 fuzzel-wrapper 先杀后开。
    // repeat=false：按住不放只会反复「杀 fuzzel、再开 fuzzel」，没有第二个意思。
    MOD+SPACE repeat=false hotkey-overlay-title="System status" {
        spawn "~/.config/niri/scripts/status"
    }

    // Applications
    MOD+RETURN hotkey-overlay-title="Open terminal (plain)" {
        spawn "footclient"
    }
    MOD+R hotkey-overlay-title="App launcher" {
        spawn "~/.config/niri/scripts/fuzzel-wrapper"
    }
    MOD+B hotkey-overlay-title="Browser" {
        spawn "~/.local/bin/scripts/qb-open"
    }
    MOD+E hotkey-overlay-title="File manager (yazi)" {
        spawn "footclient" "-e" "yazi"
    }
    MOD+N hotkey-overlay-title="Text editor (nvim)" {
        spawn "footclient" "-e" "nvim"
    }

    // Audio
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.04+"
    }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower volume" {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.04-"
    }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute audio" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute mic" {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
    }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" {
        spawn "playerctl" "next"
    }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Play/Pause" {
        spawn "playerctl" "play-pause"
    }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" {
        spawn "playerctl" "previous"
    }

    // Window ops
    MOD+Q {
        close-window
    }
    MOD+LEFT {
        focus-column-left
    }
    MOD+H {
        focus-column-left
    }
    MOD+RIGHT {
        focus-column-right
    }
    MOD+L {
        focus-column-right
    }
    MOD+UP {
        focus-window-up
    }
    MOD+K {
        focus-window-up
    }
    MOD+DOWN {
        focus-window-down
    }
    MOD+J {
        focus-window-down
    }

    // Move direction
    MOD+CTRL+LEFT {
        move-column-left
    }
    MOD+CTRL+H {
        move-column-left
    }
    MOD+CTRL+RIGHT {
        move-column-right
    }
    MOD+CTRL+L {
        move-column-right
    }
    MOD+CTRL+UP {
        move-window-up
    }
    MOD+CTRL+K {
        move-window-up
    }
    MOD+CTRL+DOWN {
        move-window-down
    }
    MOD+CTRL+J {
        move-window-down
    }

    // Column jump
    MOD+HOME {
        focus-column-first
    }
    MOD+END {
        focus-column-last
    }
    MOD+CTRL+HOME {
        move-column-to-first
    }
    MOD+CTRL+END {
        move-column-to-last
    }

    // Column merge / expel
    // Mod+[ / Mod+] : 把聚焦窗口并入相邻列，或在列中时把它拆出来
    MOD+BRACKETLEFT hotkey-overlay-title="Merge/expel window left" {
        consume-or-expel-window-left
    }
    MOD+BRACKETRIGHT hotkey-overlay-title="Merge/expel window right" {
        consume-or-expel-window-right
    }
    // Mod+, / Mod+. : 把右邻窗口吸进当前列 / 把当前列底部窗口吐出来
    MOD+COMMA hotkey-overlay-title="Consume window into column" {
        consume-window-into-column
    }
    MOD+PERIOD hotkey-overlay-title="Expel window from column" {
        expel-window-from-column
    }

    // Workspace scroll
    MOD+WHEELSCROLLDOWN {
        focus-workspace-down
    }
    MOD+WHEELSCROLLUP {
        focus-workspace-up
    }
    MOD+CTRL+WHEELSCROLLDOWN {
        move-column-to-workspace-down
    }
    MOD+CTRL+WHEELSCROLLUP {
        move-column-to-workspace-up
    }

    MOD+SHIFT+WHEELSCROLLDOWN {
        focus-column-right
    }
    MOD+SHIFT+WHEELSCROLLUP {
        focus-column-left
    }
    MOD+CTRL+SHIFT+WHEELSCROLLDOWN {
        move-column-right
    }
    MOD+CTRL+SHIFT+WHEELSCROLLUP {
        move-column-left
    }

    // Workspace switch
    MOD+1 {
        focus-workspace 1
    }
    MOD+2 {
        focus-workspace 2
    }
    MOD+3 {
        focus-workspace 3
    }
    MOD+4 {
        focus-workspace 4
    }
    MOD+5 {
        focus-workspace 5
    }
    MOD+6 {
        focus-workspace 6
    }
    MOD+7 {
        focus-workspace 7
    }
    MOD+8 {
        focus-workspace 8
    }
    MOD+9 {
        focus-workspace 9
    }

    // Workspace move
    MOD+CTRL+1 {
        move-column-to-workspace 1
    }
    MOD+CTRL+2 {
        move-column-to-workspace 2
    }
    MOD+CTRL+3 {
        move-column-to-workspace 3
    }
    MOD+CTRL+4 {
        move-column-to-workspace 4
    }
    MOD+CTRL+5 {
        move-column-to-workspace 5
    }
    MOD+CTRL+6 {
        move-column-to-workspace 6
    }
    MOD+CTRL+7 {
        move-column-to-workspace 7
    }
    MOD+CTRL+8 {
        move-column-to-workspace 8
    }
    MOD+CTRL+9 {
        move-column-to-workspace 9
    }

    MOD+SHIFT+1 hotkey-overlay-title="Move window to workspace 1" {
        move-window-to-workspace 1
    }
    MOD+SHIFT+2 hotkey-overlay-title="Move window to workspace 2" {
        move-window-to-workspace 2
    }
    MOD+SHIFT+3 hotkey-overlay-title="Move window to workspace 3" {
        move-window-to-workspace 3
    }
    MOD+SHIFT+4 hotkey-overlay-title="Move window to workspace 4" {
        move-window-to-workspace 4
    }
    MOD+SHIFT+5 hotkey-overlay-title="Move window to workspace 5" {
        move-window-to-workspace 5
    }
    MOD+SHIFT+6 hotkey-overlay-title="Move window to workspace 6" {
        move-window-to-workspace 6
    }
    MOD+SHIFT+7 hotkey-overlay-title="Move window to workspace 7" {
        move-window-to-workspace 7
    }
    MOD+SHIFT+8 hotkey-overlay-title="Move window to workspace 8" {
        move-window-to-workspace 8
    }
    MOD+SHIFT+9 hotkey-overlay-title="Move window to workspace 9" {
        move-window-to-workspace 9
    }

    // Layout
    MOD+C {
        center-column
    }
    MOD+MINUS {
        set-column-width "-10%"
    }
    MOD+EQUAL {
        set-column-width "+10%"
    }
    MOD+SHIFT+MINUS {
        set-window-height "-10%"
    }
    MOD+SHIFT+EQUAL {
        set-window-height "+10%"
    }

    // R 让给启动器后，重置高度落到 W（空闲键，不再与上面的窗高 ± 相邻）
    MOD+W hotkey-overlay-title="Reset window height" {
        reset-window-height
    }
    // 宽度预设作用于当前工作区的所有平铺窗口，而不是只改聚焦的那一列。
    // repeat=false：按住不放没有意义，还会以按键重复率反复 spawn 脚本。
    // 展开：贴边占满。脚本只看一个布尔值，重复按不会缩回。
    MOD+F repeat=false hotkey-overlay-title="Fill workspace to screen edges" {
        spawn "~/.config/niri/scripts/resize-workspace" "fill"
    }
    // 真全屏；与 Mod+Ctrl+F 同一个动作
    MOD+SHIFT+F hotkey-overlay-title="Fullscreen window" {
        fullscreen-window
    }
    MOD+D repeat=false hotkey-overlay-title="Set workspace columns to 50%" {
        spawn "~/.config/niri/scripts/resize-workspace" "50%"
    }
    MOD+S repeat=false hotkey-overlay-title="Set workspace columns to 33.3333%" {
        spawn "~/.config/niri/scripts/resize-workspace" "33.3333%"
    }
    MOD+A repeat=false hotkey-overlay-title="Set workspace columns to 25%" {
        spawn "~/.config/niri/scripts/resize-workspace" "25%"
    }

    // Clipboard
    MOD+V hotkey-overlay-title="Clipboard history" {
        spawn "~/.config/niri/scripts/cliphist-fuzzel"
    }

    // OCR
    MOD+G hotkey-overlay-title="OCR" {
        spawn "~/.config/niri/scripts/ocr-select"
    }

    // Screenshots
    MOD+P hotkey-overlay-title="Screenshot" {
        spawn "~/.config/niri/scripts/screenshot"
    }

    // Emergency escape
    MOD+ESCAPE allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }

    // Exit / Power
    CTRL+ALT+DELETE {
        quit
    }
    MOD+O repeat=false {
        toggle-overview
    }
}

// 窗口切换（MRU，带缩略图）。
// niri 的 MRU 按键只能写在 recent-windows 块里，不能放进上面的 binds。
// 切换器的外观（highlight / previews / 延时）见 appearance.kdl 的 recent-windows。
recent-windows {
    binds {
        // scope 决定范围：workspace = 只看当前工作区的窗口
        // filter 决定应用范围：app-id = 只看与焦点窗口同一个应用的窗口
        Alt+Tab         { next-window     scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
        Mod+Tab         { next-window     scope="workspace" filter="app-id"; }
        Mod+Shift+Tab   { previous-window scope="workspace" filter="app-id"; }
    }
}
