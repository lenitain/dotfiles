#!/usr/bin/luajit
-- 只在 niri overview 打开时显示 waybar。
--
-- 直接走 niri 的 IPC socket（$NIRI_SOCKET）：一行 JSON 请求，先回一行
-- {"Ok":"Handled"}，然后持续推事件行。开 overview 发 SIGUSR1、关发 SIGUSR2，
-- 两个动作在 ~/.config/waybar/config 里定义成幂等的 show / hide。所以 waybar
-- 重启、事件重复、脚本自己重连都不会把可见性弄反。
--
-- 为什么不用 `niri msg --json event-stream | while read`：那条路每次开关都要
-- fork 一个 pkill 去找 waybar 的 pid（本机实测 ~33ms，比 bar 自己的 map 还慢），
-- 还要多挂 niri msg + 子 shell 两个进程。这里 ping waybar 用 kill(2) 直接
-- 系统调用，找 pid 用 readdir 扫一遍 /proc 后缓存，两次开关之间零 fork。
--
-- 代价：SIGUSR2 不再是 waybar 的热重载，改 config 走
-- ~/.config/waybar/reload-config.sh（restart）。

local ffi = require("ffi")

ffi.cdef [[
int socket(int domain, int type, int protocol);
int connect(int fd, const void *addr, unsigned int len);
long read(int fd, void *buf, unsigned long count);
long write(int fd, const void *buf, unsigned long count);
int close(int fd);
int kill(int pid, int sig);
int usleep(unsigned int usec);
void *opendir(const char *name);
int closedir(void *dirp);

struct dirent {
    unsigned long d_ino;
    long d_off;
    unsigned short d_reclen;
    unsigned char d_type;
    char d_name[256];
};

struct dirent *readdir(void *dirp);

struct sockaddr_un {
    unsigned short sun_family;
    char sun_path[108];
};
]]

local AF_UNIX, SOCK_STREAM = 1, 1
local SIGUSR1, SIGUSR2 = 10, 12 -- Linux 固定值，x86-64 / arm64 同号

local function die(msg)
    io.stderr:write("waybar-overview: ", msg, "\n")
    os.exit(1)
end

-- ---------------- 找 waybar 的 pid ----------------

-- systemd 会重启 waybar，pid 会变，所以只缓存「上次找到的」，失效了再扫。
local function comm_is(pid, want)
    local f = io.open("/proc/" .. pid .. "/comm", "r")
    if not f then return false end
    local comm = f:read("l")
    f:close()
    return comm == want
end

local function find_waybar()
    local dir = ffi.C.opendir("/proc")
    if dir == nil then return nil end

    local found
    while true do
        local ent = ffi.C.readdir(dir)
        if ent == nil then break end

        local name = ffi.string(ent.d_name)
        if name:match("^%d+$") and comm_is(name, "waybar") then
            found = tonumber(name)
            break
        end
    end
    ffi.C.closedir(dir)
    return found
end

local waybar

local function signal(sig)
    -- kill(pid, 0) 是探活；没有 waybar 时（正在重启/没起来）就重扫一次，
    -- 还找不到就算了：它启动时是 hidden，下一次事件会自然对齐。
    if not (waybar and ffi.C.kill(waybar, 0) == 0) then
        waybar = find_waybar()
    end
    if waybar then ffi.C.kill(waybar, sig) end
end

-- ---------------- 连 niri 的 IPC socket ----------------

local function connect_niri()
    local path = os.getenv("NIRI_SOCKET")
    if not path then die("NIRI_SOCKET 未设置，不在 niri 会话里？") end
    if #path >= 108 then die("NIRI_SOCKET 路径太长") end

    local fd = ffi.C.socket(AF_UNIX, SOCK_STREAM, 0)
    if fd < 0 then return nil end

    local addr = ffi.new("struct sockaddr_un")
    addr.sun_family = AF_UNIX
    ffi.copy(addr.sun_path, path) -- 结构体零初始化，结尾自带 \0
    local len = ffi.offsetof("struct sockaddr_un", "sun_path") + #path + 1
    if ffi.C.connect(fd, addr, len) ~= 0 then
        ffi.C.close(fd)
        return nil
    end

    local request = '"EventStream"\n'
    if ffi.C.write(fd, request, #request) ~= #request then
        ffi.C.close(fd)
        return nil
    end
    return fd
end

-- ---------------- 事件循环 ----------------

local buf = ffi.new("char[65536]")

-- 事件流开头 niri 会先发一份当前状态（含 OverviewOpenedOrClosed），
-- 所以重连一次就等于自动纠偏。
local function pump(fd)
    local pending = ""
    while true do
        local n = ffi.C.read(fd, buf, ffi.sizeof(buf))
        if n <= 0 then return end

        pending = pending .. ffi.string(buf, n)
        local start = 1
        while true do
            local nl = pending:find("\n", start, true)
            if not nl then break end

            local line = pending:sub(start, nl - 1)
            start = nl + 1
            if line:find('"OverviewOpenedOrClosed"', 1, true) then
                signal(line:find('"is_open":true', 1, true) and SIGUSR1 or SIGUSR2)
            end
        end
        pending = pending:sub(start)
    end
end

-- 登录早期 socket 可能还没起来，先等一会儿；连不上十秒就认命退出。
local attempts = 0
while true do
    local fd = connect_niri()
    if fd then
        attempts = 0
        pump(fd)
        ffi.C.close(fd)
    else
        attempts = attempts + 1
        if attempts > 50 then os.exit(0) end
        ffi.C.usleep(200000)
    end
end
