#!/usr/bin/env python3
"""问 StatusNotifierWatcher：现在谁有托盘图标。

用法：
    tray-items                     每行打印「名字<TAB>总线名<TAB>对象路径<TAB>应用 id」
    tray-items activate BUS PATH   调用托盘项的 Activate（相当于点一下图标）

没有 watcher（没装托盘宿主、sni-watcher 没起）就什么都不打印，退出码 0。
"""

import os
import re
import sys

from gi.repository import Gio, GLib

WATCHER_NAME = "org.kde.StatusNotifierWatcher"
WATCHER_PATH = "/StatusNotifierWatcher"
ITEM_PATH = "/StatusNotifierItem"
ITEM_INTERFACE = "org.kde.StatusNotifierItem"

connection = None


def call(dest, path, iface, method, params, reply_type, timeout=2000):
    reply = connection.call_sync(
        dest,
        path,
        iface,
        method,
        params,
        reply_type,
        Gio.DBusCallFlags.NONE,
        timeout,
        None,
    )
    return reply.unpack()


def owner_pid(busname):
    try:
        (pid,) = call(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "GetConnectionUnixProcessID",
            GLib.Variant("(s)", (busname,)),
            GLib.VariantType("(u)"),
        )
    except GLib.Error:
        return None
    return pid


def app_id(pid):
    """从进程的 cgroup 里翻出应用 id（flatpak 的是 com.qq.QQ 这种）。"""
    try:
        with open(f"/proc/{pid}/cgroup", encoding="utf-8") as handle:
            cgroup = handle.read()
    except OSError:
        return None
    flatpak = re.search(r"app-flatpak-(.+?)-\d+\.scope", cgroup)
    if flatpak:
        return flatpak.group(1)
    plain = re.search(r"app-(.+?)(?:@[^/]*)?\.(?:scope|service)", cgroup)
    return plain.group(1) if plain else None


def desktop_name(appid):
    """按应用 id 找 desktop 文件里的 Name —— com.qq.QQ -> QQ。"""
    if not appid:
        return None
    dirs = [os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))]
    dirs += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    for directory in dirs:
        path = os.path.join(directory, "applications", appid + ".desktop")
        try:
            with open(path, encoding="utf-8") as handle:
                lines = handle.readlines()
        except OSError:
            continue
        names = {}
        for line in lines:
            if line.startswith("["):
                if not line.startswith("[Desktop Entry]"):
                    break  # 后面的组是 desktop action，名字不算
                continue
            if not line.startswith("Name"):
                continue
            key, _, value = line.partition("=")
            names[key.strip()] = value.strip()
        for key in ("Name[zh_CN]", "Name[zh]", "Name"):
            if names.get(key):
                return names[key]
    return None


def process_name(pid):
    try:
        with open(f"/proc/{pid}/comm", encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return None


def item_prop(busname, path, prop):
    """只取要的那一个属性。

    不用 GetAll：QQ 的 IconPixmap 是 128x128 的位图，整包拉回来要穿过
    flatpak 的 dbus 代理，慢上几百毫秒；单个属性则是毫秒级。
    """
    try:
        (value,) = call(
            busname,
            path,
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", (ITEM_INTERFACE, prop)),
            GLib.VariantType("(v)"),
        )
    except GLib.Error:
        return ""
    if hasattr(value, "unpack"):
        value = value.unpack()
    return value or ""


def item_identity(busname, path):
    """托盘项的名字和应用 id。

    名字优先用应用自己报的 Title；QQ 那种只给图标不给名字的，按进程反查
    desktop 文件里的 Name（com.qq.QQ -> QQ），顺带把应用 id 带出来 ——
    面板要靠它找到对应的窗口。
    """
    title = item_prop(busname, path, "Title")
    if title:
        return title, ""
    pid = owner_pid(busname)
    if pid:
        appid = app_id(pid)
        name = desktop_name(appid) or appid or process_name(pid)
        if name:
            return name, appid or ""
    return item_prop(busname, path, "Id") or busname, ""


def registered_items():
    try:
        (items,) = call(
            WATCHER_NAME,
            WATCHER_PATH,
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", (WATCHER_NAME, "RegisteredStatusNotifierItems")),
            GLib.VariantType("(v)"),
        )
    except GLib.Error:
        return []
    return items


def split_service(service):
    """注册串可能是「总线名」或「总线名/对象路径」。"""
    parts = service.split("/", 1)
    busname = parts[0]
    path = parts[1] if len(parts) > 1 else ITEM_PATH
    return busname, path


def list_items():
    for service in registered_items():
        busname, path = split_service(service)
        name, appid = item_identity(busname, path)
        print(f"{name}\t{busname}\t{path}\t{appid}")


def activate(busname, path):
    try:
        call(
            busname,
            path,
            ITEM_INTERFACE,
            "Activate",
            GLib.Variant("(ii)", (0, 0)),
            GLib.VariantType("()"),
        )
    except GLib.Error as error:
        sys.exit(f"点不动 {busname}{path}：{error.message}")


def main():
    global connection
    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    if len(sys.argv) > 1 and sys.argv[1] == "activate":
        if len(sys.argv) < 4:
            sys.exit("用法：tray-items activate BUS PATH")
        activate(sys.argv[2], sys.argv[3])
        return
    list_items()


main()
