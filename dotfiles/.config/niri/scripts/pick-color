#!/usr/bin/env bash
# 放大镜 + 取色器：shmooz 一体化搞定
#
# shmooz（Wayland 原生，wlr-screencopy + layer-shell）自带：
#   滚轮         在指针位置缩放
#   i            切换取色模式
#   取色模式下   移动指针更新色块，左键点击把 #rrggbb 复制进剪贴板
#   右键 / Esc   退出
#
# --zoom-in 的百分比是「视野占比」而非放大倍数，取值 0-99%：
# 25% = 放大 4 倍。写成 200% 会被 shmooz 直接拒绝退出。
#
# 颜色取自 shmooz 自己的抓帧，不会被它画的放大镜覆盖层污染，
# 所以既保住了 hyprpicker 那种放大镜手感，取到的色又准。
#
# 本脚本负责：启动 shmooz → 自动按 i 进入取色模式 → 取到色后弹通知。

set -uo pipefail

notify() {
    local -a args=("$1" "$2")
    [ -n "${3:-}" ] && args+=("-i" "$3")
    notify-send "${args[@]}" || true
}

# shmooz 取色后把 hex 写进剪贴板。这里盯着剪贴板，命中就通知。
# 先记下启动时的剪贴板内容，避免把旧内容误报成本次取色结果。
# 用轮询而不是 wl-paste --watch：watch 模式不会给内容补换行，
# 按行读会把连续两次取色粘成一行。
watch_picked_color() {
    local before="$1"
    local text
    while true; do
        text="$(wl-paste -n 2>/dev/null || true)"
        if [[ "$text" =~ ^\#[0-9a-fA-F]{6}$ ]] && [ "$text" != "$before" ]; then
            notify "取色器" "$text"
            break
        fi
        sleep 0.2
    done
}

command -v shmooz >/dev/null 2>&1 || {
    notify "取色器" "未安装 shmooz"
    exit 1
}

BEFORE="$(wl-paste -n 2>/dev/null || true)"

watch_picked_color "$BEFORE" &
WATCHER=$!

shmooz --zoom-in 25% &
SHMOOZ=$!

# 等 shmooz 的 layer surface 映射并拿到键盘焦点（它要的是 Exclusive），再替用户按 i
sleep 1
wtype -k i 2>/dev/null || true

wait "$SHMOOZ"
kill "$WATCHER" 2>/dev/null
wait "$WATCHER" 2>/dev/null
