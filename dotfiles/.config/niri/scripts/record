#!/usr/bin/env bash
# 录屏脚本 - gpu-screen-recorder：直接录制到磁盘，产出 MKV
#
# 子命令:
#   record start   区域选择并开始录制
#   record stop    停止当前录制（向录制进程发 SIGINT，等待其正常收尾）
#   record state   只打印当前状态：REC / BUSY / IDLE（status 通过 lib.lua 共用判定）
#                  BUSY = 没有 gsr 进程但单例锁被占着（停止时正在等录制进程收尾）
#   record toggle  在录就停、没录就开（状态面板那一行的回车动作）
#
# 只管录制，格式转换不归这里：MKV -> MP4 由 ~/.local/bin/scripts/mkv2mp4 单独做，
# 录制因此不会被转码拖住，转码失败也牵连不到原始录像。
#
# 单例语义:
#   全局同一时刻只允许一个录制。已在录制时 `record start` 不做任何事，
#   只提示"已在录制中"（绝不误停正在进行的录制）。
#
#   实现上不保存 PID：`stop` 每次现场扫描 /proc，按 exe inode 认定录制进程
#   （升级/卸载后用 comm + "<path> (deleted)" 回退），输出路径也从该进程的
#   cmdline 反查。因此不存在状态文件陈旧、跨用户覆盖、PID 被复用后误杀等问题。
#   并发保护由 flock 独占锁提供（两个 start 同时跑也只有一个能进入）。
#
# 流程:
#   录制写入 ~/videos/Record_*.mkv（H.264 硬编 CQP + Opus）
#   停止时 SIGINT 收尾，等录制进程写完文件即结束；全程不覆盖已有文件
#   要 MP4 就事后单独跑 mkv2mp4（视频直拷、音频转 AAC、+faststart），原 MKV 保留
#
# 为什么用 gpu-screen-recorder（而不是 wl-screenrec）:
#   wl-screenrec 硬编只有 VAAPI 一条路（实测其二进制内置编码器名仅 h264_vaapi 一系），
#   在 NVIDIA 机器上无法硬编。gpu-screen-recorder 把 NVENC / VAAPI / Vulkan 各厂商
#   路径编译进同一个二进制并运行时 dlopen 加载，故同一份脚本可跨 AMD/Intel/NVIDIA。
#   它同时内建了本脚本原先需要自己实现的东西：
#     - 统一编码参数（-k h264 / -q）取代厂商私有的 rc_mode=CQP,qp=N 语法
#     - 按显示器自动选择 GPU，取代手工猜 /dev/dri/renderD128
#     - -fallback-cpu-encoding 取代自己写的降级链
#      -a default_output 取代对 pulse/pipewire 后端的假设

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

RECORD_DIR="$HOME/videos"
mkdir -p "$RECORD_DIR"

# 单例闸门：flock 独占锁保证任意时刻只有一个 start 能进入临界区
# （即使两个 start 并发也不会都通过）。锁文件不存任何状态，见下方 find_recorder。
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/record.lock"

# ===== 录制设置 =====
# -k h264       统一编码器档位；底层由 gsr 选 NVENC/VAAPI/Vulkan/libx264，无需厂商参数
# -q <档位>      medium | high | very_high | ultra
#                ultra ≈ 130 KB/s，very_high ≈ 95 KB/s（本机 1920x1080 实测）
#                数值越小档位越低，文件越小、质量越低
# -bm qp        恒定质量模式（对应原先的 rc_mode=CQP）
# -cr limited   有限色彩范围，兼容性最好（full 会让部分播放器发灰）
VIDEO_CODEC="h264"
QUALITY_PRESET="ultra"
BITRATE_MODE="qp"
COLOR_RANGE="limited"

# 音频源：桌面输出。列可用设备: gpu-screen-recorder --list-audio-devices
# 不传 -a 会录不到音频，故必须显式指定。
AUDIO_SOURCE="default_output"
AUDIO_CODEC="opus"

# 硬编不可用时自动退化到 CPU 编码，避免"换了机器就完全不工作"
FALLBACK_CPU="yes"

# 是否录制鼠标光标
CAPTURE_CURSOR="no"

# 区域选择器输出格式：必须与 gsr 的 -w 区域语法一致（WxH+X+Y）
# slurp-wrapper 是裸透传（exec slurp "$@"），所以这里可直接加 -f。
# 注意：slurp 给出的是合成器暴露的坐标（本机为逻辑坐标 1536x864），
#       而 gsr 按该坐标录制后输出物理分辨率（1920x1080）。两者按显示缩放比对应。
SLURP_FMT="%wx%h+%x+%y"

# ===== 行为开关 =====
STOP_TIMEOUT_SEC=20                       # 等待录制进程收尾的最长秒数

# notify / copy_path / copy_stream 在 lib.sh 里，子进程都带 `9>&-`。
# 单例锁占用 fd 9，gsr / notify-send / wl-copy 等后台子进程一旦继承并攥住它，
# 锁会在脚本退出后继续被持有，后续 start/stop 就被自己的闸门挡死。

# 前置检查：录制器是否可用（比"起录后才发现失败"体验好）
require_recorder() {
    if [[ -z $RECORDER_BIN || ! -x $RECORDER_BIN ]]; then
        notify "录屏不可用" "未找到 gpu-screen-recorder，请先安装"
        echo "错误: 未找到 gpu-screen-recorder" >&2
        exit 127
    fi
}

# ===== 单例：不记录 PID，每次现查 =====
# 设计要点：进程身份由内核保证，而不是由我们存一个可能过期/被复用的数字。
#   - 用 /proc/<pid>/exe 认定，而不是 pgrep -x：
#     内核把 comm 截断到 15 字符（"gpu-screen-reco"），所以 pgrep -x 用完整名永远匹配不到。
#   - 单例约束下"找到任意 gsr"就是"找到我们的录制"，无需再区分是哪一个实例。
#   - 输出路径从进程自己的 cmdline 反查，因此不落任何状态文件，
#     也就不存在陈旧状态、跨用户覆盖、PID 复用误杀这些问题。
# 录制器路径：find_recorder 拿它跟 /proc/<pid>/exe 比对，必须是真实路径。
# command -v 是 shell 内建（不 fork）；找不到就留空 —— 面板的录制行也就不出现。
RECORDER_BIN="${RECORDER_BIN:-$(command -v gpu-screen-recorder || true)}"
if [[ -n $RECORDER_BIN ]]; then
    RECORDER_BIN="$(readlink -f -- "$RECORDER_BIN" 2>/dev/null || printf '%s' "$RECORDER_BIN")"
fi

find_recorder() {
    local d comm exe comm_name
    [[ -n $RECORDER_BIN ]] || return 1
    # /proc/<pid>/comm 是 executable 的 basename，内核截断到 15 字节。
    comm_name=${RECORDER_BIN##*/}
    comm_name=${comm_name:0:15}

    # 快路径：用 bash 内建的 [[ -ef ]] 比较 inode。不要逐进程 readlink，
    # 实测 352 个进程时一次全扫要 1.1 秒；-ef 只要约 5ms。
    for d in /proc/[0-9]*; do
        [[ -O $d ]] || continue
        if [ -e "$d/exe" ] && [[ "$d/exe" -ef "$RECORDER_BIN" ]]; then
            printf '%s\n' "${d#/proc/}"
            return 0
        fi
    done

    # 升级/卸载录制器时，正在录的进程仍指向旧 inode，/proc/<pid>/exe 变成
    # "<path> (deleted)"。先按 comm 预筛，只对候选进程 readlink，
    # 避免空闲时全量 fork。
    for d in /proc/[0-9]*; do
        [[ -O $d ]] || continue
        read -r comm 2>/dev/null < "$d/comm" || continue
        [[ $comm == "$comm_name" ]] || continue
        exe=$(readlink "$d/exe" 2>/dev/null) || continue
        [[ ${exe% (deleted)} == "$RECORDER_BIN" ]] || continue
        printf '%s\n' "${d#/proc/}"
        return 0
    done
    return 1
}

# 单例锁被占但找不到 gsr：多半是 stop 正在等录制进程收尾写文件。
recording_busy() {
    command -v flock >/dev/null 2>&1 || return 1
    ! flock -n "$LOCKFILE" true 2>/dev/null
}

# 从进程的 cmdline 取 -o 的输出路径（录制器启动后命令行就固定了）
recorder_output_path() {
    tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | awk '/^-o$/{getline; print; exit}'
}

do_start() {
    require_recorder

    # 已在录制则拒绝，绝不误停正在进行的录制
    local existing
    if existing="$(find_recorder)"; then
        notify "录屏提示" "已在录制中（PID ${existing}）；如需重录请先 record stop"
        exit 0
    fi
    if recording_busy; then
        notify "录屏提示" "上一段录制仍在收尾，请稍后再试"
        echo "上一段录制仍在收尾" >&2
        exit 0
    fi

    # 框选放到临界区外：flock 一旦跨过用户交互，stop / 重新框选都会被挡住。
    # 两个 start 同时框选时，后一个的 slurp-wrapper 会杀掉前一个，前者拿到空选区退出。
    local geom
    geom="$("$SCRIPT_DIR/slurp-wrapper" -f "$SLURP_FMT")" || exit 1
    [ -n "$geom" ] || exit 0

    # 单例闸门：flock 独占锁。即使两个 start 并发也只有一个能进入临界区。
    # 用 -w 3（最多等 3 秒）而不是 -n：并发时让后来者短暂等待而不是直接失败。
    exec 9>"$LOCKFILE"
    if ! flock -w 3 9; then
        notify "录屏提示" "另一处录制操作未结束，本次忽略"
        echo "另一处录制操作未结束，本次忽略" >&2
        exit 0
    fi

    # 框选期间可能已有别的 start 抢先，进锁后复查一次
    if existing="$(find_recorder)"; then
        notify "录屏提示" "已在录制中（PID ${existing}）；如需重录请先 record stop"
        exit 0
    fi

    local filename
    filename="$RECORD_DIR/Record_$(date +%Y%m%d_%H%M%S).mkv"

    # 组装参数。区域直接作为 -w 的值传入；-region 已被上游标记为 deprecated。
    local -a args=(-w "$geom"
          -k "$VIDEO_CODEC"
          -q "$QUALITY_PRESET"
          -bm "$BITRATE_MODE"
          -cr "$COLOR_RANGE"
          -ac "$AUDIO_CODEC"
          -a "$AUDIO_SOURCE"
          -cursor "$CAPTURE_CURSOR"
          -fallback-cpu-encoding "$FALLBACK_CPU"
          -o "$filename")

    # 录制器的 stderr 落日志：启动即失败时（编码器不可用/区域非法/音频设备缺失）
    # 否则用户只会看到一句"启动失败"，无从排查。
    # 9>&- 让 gsr 关闭继承来的锁 fd，否则锁会被它攥到进程退出。
    local logfile="${XDG_RUNTIME_DIR:-/tmp}/record.log"
    "$RECORDER_BIN" "${args[@]}" >"$logfile" 2>&1 9>&- &
    local wf_pid=$!

    # 启动很快失败时明确报错，而不是留下一个"看起来在录"的假象
    sleep 1
    if ! kill -0 "$wf_pid" 2>/dev/null; then
        wait "$wf_pid" 2>/dev/null || true
        local reason
        # 没匹配到关键词时 grep 退出 1；pipefail + set -e 不能让错误提示本身把脚本带走。
        reason="$(grep -iE 'error|fail|not supported|missing' "$logfile" 2>/dev/null \
            | head -2 | tr '\n' ' ' || true)"
        notify "录屏失败" "${reason:-录制进程启动即退出（详见 $logfile）}"
        echo "录屏失败: ${reason:-启动即退出}" >&2
        echo "完整日志: $logfile" >&2
        exit 1
    fi

    notify "录屏开始" "区域录制（$VIDEO_CODEC/$QUALITY_PRESET 硬编）：$filename"
}

do_stop() {
    # 不要求 RECORDER_BIN 当前仍可执行：录制中卸载/升级了录制器时，
    # 仍需靠 find_recorder 的 comm/path 回退找到并停掉旧进程。

    # 单例闸门（与 start 共用同一把锁）。start 的临界区很短（约 1 秒），
    # 所以这里短暂等待即可，避免"恰好撞上 start 就静默不干活"。
    exec 9>"$LOCKFILE"
    if ! flock -w 3 9; then
        notify "录屏提示" "另一处录制操作未结束，本次忽略"
        echo "另一处录制操作未结束，本次忽略" >&2
        exit 0
    fi

    # 现场查进程：不依赖任何状态文件，因此没有陈旧状态/PID 复用问题。
    # 单例约束下"唯一的 gsr 进程"就是本次录制。
    local PID
    if ! PID="$(find_recorder)"; then
        notify "录屏提示" "没有正在进行的录制"
        exit 0
    fi

    # 输出路径取自进程自己的 cmdline —— 这是最可信的来源，
    # 因为它就是录制器真正写文件用的那个路径。
    local REC_FILE
    REC_FILE="$(recorder_output_path "$PID" || true)"
    if [ -z "$REC_FILE" ]; then
        notify "录屏停止异常" "无法从进程 ${PID} 的 cmdline 读取输出路径"
        exit 1
    fi

    # 发 SIGINT 让 gpu-screen-recorder 正常收尾写文件
    kill -INT "$PID" 2>/dev/null || true

    # 等待进程退出
    local i=0 max_iter=$((STOP_TIMEOUT_SEC * 10))
    while kill -0 "$PID" 2>/dev/null; do
        if [ "$i" -ge "$max_iter" ]; then
            kill -KILL "$PID" 2>/dev/null || true
            notify "录屏停止异常" "未能在 ${STOP_TIMEOUT_SEC}s 内收尾，文件可能不完整：${REC_FILE}"
            exit 1
        fi
        sleep 0.1
        i=$((i + 1))
    done

    if [ ! -s "${REC_FILE:-}" ]; then
        notify "录屏失败" "没有产出有效的录像文件：${REC_FILE:-}"
        exit 1
    fi

    # 收尾完成就完事：录像路径进剪贴板，需要 MP4 时再单独跑 mkv2mp4。
    copy_path "$REC_FILE" || true
    notify "录屏已保存" "$REC_FILE"
}

# 正在录 → "REC"，收尾中 → "BUSY"，没在录 → "IDLE"。
# 时长不报：面板要的是当前状态，不是录了多久。
# 录制器没装且没有进行中的录制时什么都不输出：面板上那一行不出现。
# 判定逻辑放在 lib.lua，和 status 共用同一份实现。
do_state() {
    [[ -n $RECORDER_BIN ]] || exit 0
    local state
    state=$(RECORDER_BIN="$RECORDER_BIN" "$SCRIPT_DIR/state.lua" record 2>/dev/null) || exit 0
    printf '%s\n' "$state"
}

# 状态面板那一行的回车动作：在录就停（收尾保存 MKV），收尾中就先别开新录制，
# 没录就选区开录。判定仍由 find_recorder / recording_busy 给，与 start/stop
# 用的是同一份事实。
do_toggle() {
    if find_recorder >/dev/null; then
        do_stop
    elif recording_busy; then
        notify "录屏提示" "上一段录制仍在收尾，请稍后再试"
        echo "上一段录制仍在收尾" >&2
        exit 0
    else
        do_start
    fi
}

case "${1:-}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    state)
        do_state
        ;;
    toggle)
        do_toggle
        ;;
    *)
        echo "用法: record {start|stop|state|toggle}" >&2
        exit 1
        ;;
esac
