#!/usr/bin/luajit
-- 把宽度预设一次应用到当前工作区的所有平铺窗口。
--
--   resize-workspace fill       每个窗口贴边铺满（Mod+F）
--   resize-workspace 50%        每列宽度设为工作区的 50%（Mod+D）
--   resize-workspace 33.3333%   ……（Mod+S）
--   resize-workspace 25%        ……（Mod+A）
--
-- 宽度预设之后会把可见列整体居中（center-visible-columns）。
--
-- 直接走 niri 的 IPC socket（$NIRI_SOCKET），协议是「一行 JSON 请求，一行 JSON 回复」，
-- 所以一次按键只有一个 luajit 进程 + 一次 connect，不起 bash/jq/niri msg 子进程。
-- 动作都带窗口 id，不会改动聚焦。
--
-- 浮窗不参与：宽度预设对浮窗没有意义，贴边还会把浮窗拉进平铺布局。
-- 贴边用的是 toggle，而 IPC 里没有 is_maximized 字段；贴边时边框被吃掉，
-- tile_size 与 window_size 相等，普通窗口则相差两边框宽度。二者都取自当前布局，
-- 不随 resize 动画插值 —— 用它挡掉已经贴边/正在展开的窗口，
-- 连按 Mod+F 只会保持铺满，不会缩回去。
-- 前提是 layout.border 非 off / width 非 0；否则普通窗口的二者也相等，
-- 与贴边不可区分。本配置 border on / width 1。
--
-- MaximizeWindowToEdges 是 toggle：普通多窗口列会被 niri 拆成一列一个窗口再最大化，
-- 标签列则整列一起最大化。fill 每轮每列只发一个目标，提交后按目标所在列判断影响范围；
-- 宽度预设才按列去重。

local dir = arg[0]:match("^(.*)/") or "."
package.path = dir .. "/?.lua;" .. package.path
local lib = require("lib")

local POLL_SECONDS = 0.01

local function die(msg)
    io.stderr:write("resize-workspace: ", msg, "\n")
    os.exit(1)
end

local mode = arg[1]
local proportion = mode and tonumber(mode:match("^(%d+%.?%d*)%%$"))
if mode ~= "fill" and not proportion then
    die("用法: resize-workspace fill|<百分比>")
end

-- 取字段值，跳过字符串里的内容（标题里出现 "is_floating":false 这种字面量时不误判）。
-- 只处理本脚本用到的取值：数字、true/false、数组。
local function value_at(json, i)
    local c = json:sub(i, i)
    if c == '"' then
        local j, escaped = i + 1, false
        while j <= #json do
            local d = json:sub(j, j)
            if escaped then escaped = false
            elseif d == "\\" then escaped = true
            elseif d == '"' then return json:sub(i + 1, j - 1) end
            j = j + 1
        end
    elseif c == "[" then
        local depth, in_string, escaped = 0, false, false
        local j = i
        while j <= #json do
            local d = json:sub(j, j)
            if in_string then
                if escaped then escaped = false
                elseif d == "\\" then escaped = true
                elseif d == '"' then in_string = false end
            elseif d == '"' then in_string = true
            elseif d == "[" then depth = depth + 1
            elseif d == "]" then
                depth = depth - 1
                if depth == 0 then return json:sub(i, j) end
            end
            j = j + 1
        end
    else
        local j = i
        while j <= #json and not json:sub(j, j):match("[,}%]]") do j = j + 1 end
        return json:sub(i, j - 1)
    end
end

local function field(json, name)
    local key = '"' .. name .. '"'
    local in_string, escaped = false, false
    local i = 1
    while i <= #json do
        local c = json:sub(i, i)
        if in_string then
            if escaped then escaped = false
            elseif c == "\\" then escaped = true
            elseif c == '"' then in_string = false end
        elseif c == '"' and json:sub(i, i + #key - 1) == key then
            local j = i + #key
            while json:sub(j, j):match("%s") do j = j + 1 end
            if json:sub(j, j) == ":" then
                j = j + 1
                while json:sub(j, j):match("%s") do j = j + 1 end
                return value_at(json, j)
            end
            in_string = true
        elseif c == '"' then
            in_string = true
        end
        i = i + 1
    end
    return nil
end

local function query(name)
    local payload, err = lib.niri_query(name)
    if not payload then die(name .. " 请求失败: " .. err) end
    local array = payload:match('^{"' .. name .. '":(.*)}$')
    if not array then die("解析 " .. name .. " 回复失败: " .. payload) end
    return lib.json_objects(array)
end

local focused_ws
for _, workspace in ipairs(query("Workspaces")) do
    if field(workspace, "is_focused") == "true" then
        focused_ws = tonumber(field(workspace, "id"))
        break
    end
end
if not focused_ws then die("找不到聚焦工作区") end

-- 取当前工作区的平铺窗口布局。贴边窗口没有边框，tile_size 与 window_size 相等；
-- 普通窗口二者相差两边框宽度（本配置 width 1）。
-- 与 window_offset_in_tile 不同，这两个值不随 resize 动画插值，
-- 不会在窗口展开到一半时把 offset 判回边框宽度、再 toggle 一次。
local function layout_snapshot(workspace_id)
    local result = {}
    for _, window in ipairs(query("Windows")) do
        local id = tonumber(field(window, "id"))
        local ws = tonumber(field(window, "workspace_id"))
        local pos = field(window, "pos_in_scrolling_layout")
        if id and ws == workspace_id and field(window, "is_floating") == "false" then
            local column = pos and tonumber(pos:match("^%[%s*(%d+),")) or id
            local tile_width = tonumber((field(window, "tile_size") or ""):match("^%[%s*([^,]+),"))
            local window_width = tonumber((field(window, "window_size") or ""):match("^%[%s*([^,]+),"))
            if column and tile_width and window_width then
                result[#result + 1] = {
                    id = id,
                    column = column,
                    width = tile_width,
                    filled = tile_width == window_width,
                }
            end
        end
    end
    return result
end

-- 已提交的列宽（按列去重）。客户端提交新尺寸之前，这里还是旧宽度。
local function column_widths(workspace_id)
    local widths = {}
    for _, window in ipairs(layout_snapshot(workspace_id)) do
        widths[window.column] = window.width
    end
    return widths
end

-- 两份列宽是否一致：列集合相同，且宽度相差不超过 0.5。
local function widths_equal(a, b)
    for column, width in pairs(a) do
        if b[column] == nil or math.abs(b[column] - width) > 0.5 then return false end
    end
    for column in pairs(b) do
        if a[column] == nil then return false end
    end
    return true
end

-- 等列宽提交：niri 记的是客户端已提交的列宽，提交前发居中动作会按旧宽度算位置。
-- 连续两轮读数一致才算落定。一轮都没变说明本来就是这个宽度，
-- 等到超时也继续，居中按当前宽度算就是对的。
local function wait_widths_committed(workspace_id, before, timeout_ms)
    local prev, stable = nil, 0
    for _ = 1, timeout_ms / 10 do
        local cur = column_widths(workspace_id)
        if prev and widths_equal(prev, cur) then
            stable = stable + 1
            if stable >= 2 and not widths_equal(before, cur) then return true end
        else
            stable = 0
        end
        prev = cur
        lib.nanosleep(POLL_SECONDS)
    end
    return false
end

local function find_window(windows, id)
    for _, window in ipairs(windows) do
        if window.id == id then return window end
    end
end

local function maximize_window(id)
    local _, err = lib.niri_request('{"Action":{"MaximizeWindowToEdges":{"id":' .. id .. '}}}')
    return err
end

-- niri 的动作回复早于客户端提交新尺寸；等 expected 里的窗口 tile_size 追平 window_size。
-- 窗口已关闭时没有可等的对象，按已处理返回。
local function wait_all_filled(workspace_id, expected, timeout_ms)
    for _ = 1, timeout_ms / 10 do
        local by_id = {}
        for _, window in ipairs(layout_snapshot(workspace_id)) do
            by_id[window.id] = window
        end
        local remaining = 0
        for id in pairs(expected) do
            local window = by_id[id]
            if window and not window.filled then remaining = remaining + 1 end
        end
        if remaining == 0 then return true end
        lib.nanosleep(POLL_SECONDS)
    end
    return false
end

-- MaximizeWindowToEdges 是 toggle：普通多窗口列会被 niri 拆成一列一个窗口再最大化，
-- 标签列则整列一起最大化。每轮每个列只处理一个窗口：动作后普通列的目标已被拆到
-- 新列，同列其余窗口下一轮仍会被选中；标签列的目标仍和整列在一起，整列标记处理。
local function fill_workspace(workspace_id)
    local done, expected = {}, {}
    while true do
        local targets, target_ids = {}, {}
        local columns = {}
        for _, window in ipairs(layout_snapshot(workspace_id)) do
            if not window.filled and not done[window.id] and not columns[window.column] then
                columns[window.column] = true
                targets[#targets + 1] = window
                target_ids[window.id] = true
            end
        end
        if #targets == 0 then break end

        for _, window in ipairs(targets) do
            done[window.id] = true
            local err = maximize_window(window.id)
            if err then
                io.stderr:write("resize-workspace: ", err, "\n")
                target_ids[window.id] = nil
            else
                expected[window.id] = true
            end
        end

        -- 动作回复早于客户端提交新尺寸；等本轮目标都提交后再看列结构。
        if not wait_all_filled(workspace_id, target_ids, 500) then
            io.stderr:write("resize-workspace: 部分列未在预期时间内贴边\n")
        end

        -- 目标提交后所在的整列就是这次动作影响的列：普通列只剩被拆出的目标，
        -- 标签列仍包含同列窗口。整列标记掉，下一轮才不会再次 toggle。
        local after = layout_snapshot(workspace_id)
        local target_columns = {}
        for id in pairs(target_ids) do
            local window = find_window(after, id)
            if window then target_columns[window.column] = true end
        end
        for _, window in ipairs(after) do
            if target_columns[window.column] then
                done[window.id] = true
                if not window.filled then expected[window.id] = true end
            end
        end
    end

    -- 等动作都落到客户端；这样紧接着再按 Mod+F 时，仍在提交中的窗口不会被判成未贴边。
    if not wait_all_filled(workspace_id, expected, 1000) then
        io.stderr:write("resize-workspace: 部分窗口未在预期时间内贴边\n")
    end
end

if mode == "fill" then
    fill_workspace(focused_ws)
else
    local before = column_widths(focused_ws)
    local columns = {}
    for _, window in ipairs(layout_snapshot(focused_ws)) do
        if not columns[window.column] then
            columns[window.column] = true
            local _, err = lib.niri_request('{"Action":{"SetWindowWidth":{"id":' .. window.id ..
                ',"change":{"SetProportion":' .. proportion .. '}}}}')
            if err then io.stderr:write("resize-workspace: ", err, "\n") end
        end
    end
    -- 新列宽提交之后再居中，否则 niri 按旧宽度算位置。
    wait_widths_committed(focused_ws, before, 500)
    local _, err = lib.niri_request('{"Action":{"CenterVisibleColumns":{}}}')
    if err then io.stderr:write("resize-workspace: ", err, "\n") end
end
