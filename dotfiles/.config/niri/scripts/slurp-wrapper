#!/bin/bash
# slurp wrapper - 单实例框选，先杀后开（新截取替换旧截取）
# 与 fuzzel-wrapper 同一模式：任何新的框选请求都会顶掉正在进行的旧框选
#
# 等旧实例真的退出，而不是固定 sleep：原来每次白等 10ms，这里 pidof 拿一次 pid，
# kill 之后用 bash 内建的 kill -0 盯到进程消失，通常 1-2ms。循环有上限，卡住也不会
# 把按键拖住。

pids=$(pidof slurp 2>/dev/null) || pids=''
if [ -n "$pids" ]; then
    kill $pids 2>/dev/null
    for pid in $pids; do
        for _ in {1..200}; do
            kill -0 "$pid" 2>/dev/null || break
        done
    done
fi

exec /usr/bin/slurp "$@"
