#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"

REGION=$("$SCRIPT_DIR/slurp-wrapper")
if [ -z "$REGION" ]; then
  exit 1
fi

TMP=$(mktemp /tmp/ocr_XXXXXX)
grim -g "$REGION" "$TMP"
# 不能用 xargs：它把引号/反斜杠当语法，OCR 文本里一个撇号就会让整段输出丢失。
TEXT=$(tesseract "$TMP" stdout -l chi_sim+eng 2>/dev/null \
    | tr -s '[:space:]' ' ')
TEXT=${TEXT# }
TEXT=${TEXT% }
rm -f "$TMP"

if [ -z "$TEXT" ]; then
  notify-send "OCR" "No text recognized"
  exit 1
fi

if copy_path "$TEXT"; then
  notify-send "OCR(copied to clipboard): " "${TEXT}"
fi
