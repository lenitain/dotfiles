#!/usr/bin/env python3
"""最小 StatusNotifierWatcher —— 给托盘图标一个「宿主」。

本机没装任何托盘宿主（waybar / ags / waytray），会话总线上也就没有
org.kde.StatusNotifierWatcher。按 SNI 规范，应用发现没有 watcher 就不会
注册自己的托盘项：QQ 起来了也会在总线上不留痕迹，面板里自然看不到它。

这个进程只做一件事：占住 watcher 这个名字，把应用的注册请求收下，并按规范
报出「现在注册了哪些托盘项」。自己不画图标 —— 谁有托盘图标、叫什么，
面板去问它就行。

真的托盘宿主起来时会来抢这个名字（我们允许被替换），本进程随即退出，
把位置让出去；名字若已经被别人占着，本进程也直接退出，不排队等着。
"""

import sys

from gi.repository import Gio, GLib

WATCHER_NAME = "org.kde.StatusNotifierWatcher"
WATCHER_PATH = "/StatusNotifierWatcher"

WATCHER_XML = """
<node>
  <interface name="org.kde.StatusNotifierWatcher">
    <method name="RegisterStatusNotifierItem">
      <arg type="s" name="service" direction="in"/>
    </method>
    <method name="RegisterStatusNotifierHost">
      <arg type="s" name="service" direction="in"/>
    </method>
    <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
    <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
    <property name="ProtocolVersion" type="i" access="read"/>
  </interface>
</node>
"""

items = []
hosts = []
connection = None


def emit(event, service):
    connection.emit_signal(
        None,
        WATCHER_PATH,
        WATCHER_NAME,
        event,
        GLib.Variant("(s)", (service,)),
    )


def on_call(_conn, _sender, _path, _interface, method, params, invocation):
    if method == "RegisterStatusNotifierItem":
        service = params.get_child_value(0).get_string()
        if service and service not in items:
            items.append(service)
            emit("StatusNotifierItemRegistered", service)
    elif method == "RegisterStatusNotifierHost":
        host = params.get_child_value(0).get_string()
        if host and host not in hosts:
            hosts.append(host)
    invocation.return_value(None)


def get_property(_conn, _sender, _path, _interface, prop):
    if prop == "RegisteredStatusNotifierItems":
        return GLib.Variant("as", items)
    if prop == "IsStatusNotifierHostRegistered":
        return GLib.Variant("b", bool(hosts))
    if prop == "ProtocolVersion":
        return GLib.Variant("i", 0)
    return None


def alive(busname):
    """总线名还有没有主人在 —— 应用退了，名字就没了。

    查不到（总线抖了一下）不等于死了：这种情况返回 None，交给调用方
    留着这一项，等下一轮再问。
    """
    try:
        reply = connection.call_sync(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "NameHasOwner",
            GLib.Variant("(s)", (busname,)),
            GLib.VariantType("(b)"),
            Gio.DBusCallFlags.NONE,
            1000,
            None,
        )
    except GLib.Error:
        return None
    return reply.unpack()[0]


def prune():
    """死掉的注册项清掉：应用退出后总线名消失，留着只会显示一个点不亮的图标。"""
    for service in list(items):
        if alive(service.split("/", 1)[0]) is not False:
            continue
        items.remove(service)
        emit("StatusNotifierItemUnregistered", service)
    return True


def main():
    global connection
    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    node = Gio.DBusNodeInfo.new_for_xml(WATCHER_XML)
    connection.register_object(
        WATCHER_PATH, node.interfaces[0], on_call, get_property, None
    )

    state = {"acquired": False}

    def acquired(_conn, name):
        state["acquired"] = True
        print(f"sni-watcher: {name} 就位", flush=True)

    def lost(_conn, name):
        print(f"sni-watcher: {name} 让给别人，退出", flush=True)
        sys.exit(0)

    Gio.bus_own_name_on_connection(
        connection,
        WATCHER_NAME,
        Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
        acquired,
        lost,
    )

    # 名字已经有人占着（比如用户装了 waytray）：不等、不排队，直接退出。
    def give_up():
        if not state["acquired"]:
            print(f"sni-watcher: {WATCHER_NAME} 已被占用，退出", flush=True)
            sys.exit(0)
        return False

    GLib.timeout_add_seconds(2, prune)
    GLib.timeout_add_seconds(2, give_up)
    GLib.MainLoop().run()


try:
    main()
except GLib.Error as error:
    # 没有会话总线（早于 dbus 启动）之类的情况：安静退出，别在启动日志里刷栈
    print(f"sni-watcher: 起不来（{error.message}）", flush=True)
    sys.exit(1)
