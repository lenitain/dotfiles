#!/bin/bash
# 状态面板：在 fuzzel 里看系统状态快照。取代原先「只在 overview 出现的 waybar」。
#
# 宽度 / 行数 / 排序 / namespace 这些跟用途走的项在
# ~/.config/fuzzel/status.ini（和启动器、剪贴板共用 common.ini 的主题）；
# 这里只管两件事：凑出读数，再把选中行翻译成动作。
#
# 每行两列，tab 分隔：第 1 列是读数，第 2 列是回车时执行的动作（可空）。
#   --with-nth=1     只显示读数列
#   --accept-nth=2   回车只回报动作名 —— 读数怎么排版、带什么空格符号，
#                    都进不了 shell，也就不需要转义
#   --only-match     打到不匹配的字符串时，回车不给「把输入原样返回」的出口
# 面板是快照，没有实时刷新：再按一次 MOD+SPACE 就是刷新（fuzzel-wrapper 先杀后开），
# 时钟也会跟着重新取值。

set -u
# %a 固定英文星期：本机 locale 是中文，会输出「六」；三字母宽度稳定，
# 时间那列不会随星期长短左右跳。
export LC_TIME=C

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BAT=/sys/class/power_supply/BAT1

# 电量：直接读 sysfs，一次 fork 都不花。充电/满电换成插头字形，与档位图标
# 同宽，右边缘的位置不随状态跳动。
battery() {
    local cap status energy power secs icon
    local icons=(󰁺 󰁼 󰁾 󰂀 󰂂)
    [[ -r $BAT/capacity ]] || return 0
    read -r cap < "$BAT/capacity"
    read -r status < "$BAT/status"
    case $status in
        Charging | Full) icon=󰂄 ;;
        *) icon=${icons[cap * 5 / 101]} ;;
    esac
    if [[ $status != Charging && $status != Full && -r $BAT/energy_now && -r $BAT/power_now ]]; then
        read -r energy < "$BAT/energy_now"
        read -r power < "$BAT/power_now"
        if ((power > 0)); then
            # 按半小时取整：瞬时功率一直在跳，精确到分钟会让每次打开面板都
            # 显示不一样的数字，读起来不像「状态」而像「噪声」。
            secs=$(((energy * 3600 / power) / 1800 * 1800))
            printf -v icon '%s · %dh%02d' "$icon" $((secs / 3600)) $((secs % 3600 / 60))
        fi
    fi
    printf '%s%% %s\n' "$cap" "$icon"
}

# 音量：wpctl 一次 fork（实测 20ms，是面板里最贵的一项）。
volume() {
    local out pct icon
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
    if [[ $out == *MUTED* ]]; then
        printf '静音 󰖁\n'
        return
    fi
    # "Volume: 0.36" → 36：去掉小数点就是百分数，10# 防止 036 被当八进制
    out=${out#Volume: }
    pct=$((10#${out/./}))
    if ((pct == 0)); then icon=󰕿
    elif ((pct < 50)); then icon=󰖀
    else icon=󰕾
    fi
    printf '%d%% %s\n' "$pct" "$icon"
}

# 亮度：两个后端，内置屏和外接显示器各走一条。
#   brightnessctl — sysfs backlight（笔记本内置屏，amdgpu/intel…）
#   ddcutil       — DDC/CI（外接显示器；笔记本内屏不支持，detect 会明说）
# 两个后端都没有可用设备时整行不出现。
brightness() {
    local pct icon
    pct=$(brightness_pct) || return 0
    if ((pct < 30)); then icon=
    else icon=
    fi
    printf '%d%% %s\n' "$pct" "$icon"
}

# brightnessctl 的机器可读输出：device,class,value,percentage%,max。
# 百分比自己按 value/max 算，不靠那个 percentage 字段（各版本字段数不一样）。
brightnessctl_pct() {
    local info value max
    info=$(brightnessctl -m info 2>/dev/null) || return 1
    info=${info%%$'\n'*}
    value=${info#*,}
    value=${value#*,}
    value=${value%%,*}
    max=${info##*,}
    [[ $value =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || return 1
    ((max > 0)) || return 1
    printf '%d\n' "$((value * 100 / max))"
}

# ddcutil：读 DDC/CI 亮度（VCP code 4）。没有支持 DDC/CI 的显示器时失败。
# stdin 接 /dev/null：多块显示器时 ddcutil 会提示选屏并等输入，接了终端就会卡住。
ddcutil_pct() {
    local out
    out=$(ddcutil getvcp 4 </dev/null 2>/dev/null) || return 1
    out=${out#*Current brightness: }
    out=${out%%,*}
    out=${out// /}
    [[ $out =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$out"
}

# 内置屏优先（它才是天天在用的那块屏），没有 backlight 再试外接显示器。
brightness_pct() {
    local pct
    pct=$(brightnessctl_pct) && {
        printf '%s\n' "$pct"
        return 0
    }
    pct=$(ddcutil_pct) || return 1
    printf '%s\n' "$pct"
}

# 写亮度：brightnessctl 只认原始值（它的百分比参数走指数曲线，写 50%
# 读回来是 84%），所以自己按 max 换算，所见即所得；
# ddcutil 用显示器自己的 0-100 刻度。
brightness_set() {
    local pct=$1 info device max value
    if info=$(brightnessctl -m info 2>/dev/null); then
        info=${info%%$'\n'*}
        device=${info%%,*}
        max=${info##*,}
        if [[ $max =~ ^[0-9]+$ ]] && ((max > 0)); then
            value=$((max * pct / 100))
            brightnessctl -d "$device" set "$value" >/dev/null 2>&1 && return 0
        fi
    fi
    ddcutil setvcp 4 "$pct" </dev/null >/dev/null 2>&1
}

# 回车：再弹一个 fuzzel 选亮度档位。面板是快照，改完得重开才看得到，
# 给几档直接选，比无声地加 10% 更好按。
brightness_pick() {
    local choice
    choice=$(printf '100%%\n75%%\n50%%\n25%%\n' | "$dir/fuzzel-wrapper" \
        --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
        --dmenu --prompt='亮度  ' --with-nth=1 --only-match) || return 0
    choice=${choice%%%}
    [[ $choice =~ ^[0-9]+$ ]] || return 0
    brightness_set "$choice" || return 0
    notify-send "亮度" "$choice%" || true
}

# 输入法：fcitx5-remote 只回 1/2（英/中）和组名（keyboard-us、rime…）。
# 托盘没了以后，这里是「现在是中文还是英文」唯一的显示处。
ime() {
    local on
    on=$(fcitx5-remote 2>/dev/null) || return 0
    if [[ $on == 2 ]]; then
        printf '中 · %s\n' "$(fcitx5-remote -n)"
    else
        printf '英 · %s\n' "$(fcitx5-remote -n)"
    fi
}

# 熄屏抑制：判断交给 idle-inhibit 自己（它查的就是 swayidle 读的那把锁），
# 别在这里复制一份 logind 查询逻辑。输出只认 on / off 两种，别的一律不显示。
idle() {
    case $("$dir/idle-inhibit" state 2>/dev/null) in
        on) printf '熄屏抑制 · 开 󰍹\n' ;;
        off) printf '熄屏抑制 · 关 󰍹\n' ;;
    esac
}

clock() { printf '%(%m-%d %a %H:%M)T\n' -1; }

# 取不到读数就整行不出现：宁可少一行，也不要一行空白占着位置。
row() {
    [[ -n $1 ]] || return 0
    printf '%s\t%s\n' "$1" "${2-}"
}

snapshot() {
    row "$(clock)"
    row "$(volume)" volume
    row "$(brightness)" brightness
    row "$(battery)"
    row "$(ime)" ime
    row "$(idle)" idle
}

# --print 只吐数据、不开窗，用来调试和核对读数。
if [[ ${1-} == --print ]]; then
    snapshot
    exit
fi

action=$(snapshot | "$dir/fuzzel-wrapper" \
    --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
    --dmenu --prompt='状态  ' --with-nth=1 --accept-nth=2 --only-match)

case $action in
    volume) niri msg action spawn -- pavucontrol ;;
    brightness) brightness_pick ;;
    ime) fcitx5-remote -t ;;
    idle) "$dir/idle-inhibit" toggle ;;
esac
