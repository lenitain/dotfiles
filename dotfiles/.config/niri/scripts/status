#!/bin/bash
# 状态面板：在 fuzzel 里看系统状态快照。取代原先「只在 overview 出现的 waybar」。
#
# 宽度 / 行数 / 排序 / namespace 这些跟用途走的项在
# ~/.config/fuzzel/status.ini（和启动器、剪贴板共用 common.ini 的主题）；
# 这里只管两件事：凑出读数，再把选中行翻译成动作。
#
# 每行两列，tab 分隔：第 1 列是读数（以图标开头），第 2 列是回车时执行的动作（可空）。
#   --with-nth=1     只显示读数列
#   --accept-nth=2   回车只回报动作名 —— 读数怎么排版、带什么空格符号，
#                    都进不了 shell，也就不需要转义
#   --only-match     打到不匹配的字符串时，回车不给「把输入原样返回」的出口
# 面板是快照，没有实时刷新：再按一次 MOD+SPACE 就是刷新（fuzzel-wrapper 先杀后开），
# 时钟也会跟着重新取值。

set -u
# %a 固定英文星期：本机 locale 是中文，会输出「六」；三字母宽度稳定，
# 时间那列不会随星期长短左右跳。
export LC_TIME=C

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BAT=/sys/class/power_supply/BAT1

# 图标：Nerd Font 字形（Maple Mono NF CN 自带）。每行读数的第一个字符就是图标，
# 图标列对齐成一条竖线，扫一眼就知道这一行是什么，不用逐字读。
ICON_CALENDAR=󰃭   # nf-md-calendar
ICON_SUN=󰖨        # nf-md-white-balance-sunny
ICON_LANGUAGE=󰗊   # nf-md-translate
ICON_MONITOR=󰍹    # nf-md-monitor
# 工作区：3×3 的方块 —— 工作区切换器的老记号（一个方块一个工作区）
ICON_WORKSPACE=󰀻  # nf-md-apps
# 音量统一用「大声」那档图标，音量大小交给百分数表达；静音另有一个
ICON_VOLUME=󰕾
# 音量为 0（但没静音）用「喇叭不出声」那档：没有波形，也不是静音那把斜杠，
# 跟静音一眼分得开
ICON_VOLUME_ZERO=󰕿
ICON_MUTE=󰖁
# 电量五档：10 / 30 / 50 / 70 / 90，充电另有一个
ICON_BATTERY=(󰁺 󰁼 󰁾 󰂀 󰂂)
ICON_CHARGING=󰂄

# AC 适配器通没通电：sysfs 的 online。适配器名字各机不同
# （AC / AC0 / ACAD…），glob 找带 online 的那个；多路适配器任一路通电即算接通。
ac_online() {
    local file online
    for file in /sys/class/power_supply/AC*/online; do
        [[ -r $file ]] || continue
        read -r online < "$file"
        [[ $online == 1 ]] && return 0
    done
    return 1
}

# 电量：直接读 sysfs，一次 fork 都不花。
# 图标只回答「电源接没接」：插着电是带闪电的电池，没插电是电量档位 —— 两者同宽，
# 图标列的位置不随状态跳动。「在不在充」不看图标（设了充电上限时插着电也是
# Not charging），接没接电由图标自己说。
battery() {
    local cap icon
    [[ -r $BAT/capacity ]] || return 0
    read -r cap < "$BAT/capacity"
    if ac_online; then
        icon=$ICON_CHARGING
    else
        icon=${ICON_BATTERY[cap * 5 / 101]}
    fi
    printf '%s  %d%%\n' "$icon" "$cap"
}

# 音量：wpctl 一次 fork（实测 20ms，是面板里最贵的一项）。
volume() {
    local out pct
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
    if [[ $out == *MUTED* ]]; then
        printf '%s  Muted\n' "$ICON_MUTE"
        return
    fi
    # "Volume: 0.36" → 36：去掉小数点就是百分数，10# 防止 036 被当八进制
    out=${out#Volume: }
    pct=$((10#${out/./}))
    if ((pct == 0)); then
        printf '%s  0%%\n' "$ICON_VOLUME_ZERO"
        return
    fi
    printf '%s  %d%%\n' "$ICON_VOLUME" "$pct"
}

# 亮度：两个后端，内置屏和外接显示器各走一条。
#   brightnessctl — sysfs backlight（笔记本内置屏，amdgpu/intel…）
#   ddcutil       — DDC/CI（外接显示器；笔记本内屏不支持，detect 会明说）
# 两个后端都没有可用设备时整行不出现。
brightness() {
    local pct
    pct=$(brightness_pct) || return 0
    printf '%s  %d%%\n' "$ICON_SUN" "$pct"
}

# brightnessctl 的机器可读输出：device,class,value,percentage%,max。
# 百分比自己按 value/max 算，不靠那个 percentage 字段（各版本字段数不一样）。
brightnessctl_pct() {
    local info value max
    info=$(brightnessctl -m info 2>/dev/null) || return 1
    info=${info%%$'\n'*}
    value=${info#*,}
    value=${value#*,}
    value=${value%%,*}
    max=${info##*,}
    [[ $value =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || return 1
    ((max > 0)) || return 1
    printf '%d\n' "$((value * 100 / max))"
}

# ddcutil：读 DDC/CI 亮度（VCP code 4）。没有支持 DDC/CI 的显示器时失败。
# stdin 接 /dev/null：多块显示器时 ddcutil 会提示选屏并等输入，接了终端就会卡住。
ddcutil_pct() {
    local out
    out=$(ddcutil getvcp 4 </dev/null 2>/dev/null) || return 1
    out=${out#*Current brightness: }
    out=${out%%,*}
    out=${out// /}
    [[ $out =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$out"
}

# 内置屏优先（它才是天天在用的那块屏），没有 backlight 再试外接显示器。
brightness_pct() {
    local pct
    pct=$(brightnessctl_pct) && {
        printf '%s\n' "$pct"
        return 0
    }
    pct=$(ddcutil_pct) || return 1
    printf '%s\n' "$pct"
}

# 写亮度：brightnessctl 只认原始值（它的百分比参数走指数曲线，写 50%
# 读回来是 84%），所以自己按 max 换算，所见即所得；
# ddcutil 用显示器自己的 0-100 刻度。
brightness_set() {
    local pct=$1 info device max value
    if info=$(brightnessctl -m info 2>/dev/null); then
        info=${info%%$'\n'*}
        device=${info%%,*}
        max=${info##*,}
        if [[ $max =~ ^[0-9]+$ ]] && ((max > 0)); then
            value=$((max * pct / 100))
            brightnessctl -d "$device" set "$value" >/dev/null 2>&1 && return 0
        fi
    fi
    ddcutil setvcp 4 "$pct" </dev/null >/dev/null 2>&1
}

# 回车：再弹一个 fuzzel 选亮度档位。面板是快照，改完得重开才看得到，
# 给几档直接选，比无声地加 10% 更好按。
brightness_pick() {
    local choice
    choice=$(printf '100%%\n75%%\n50%%\n25%%\n' | "$dir/fuzzel-wrapper" \
        --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
        --dmenu --prompt="Brightness " --with-nth=1 --only-match) || return 0
    choice=${choice%%%}
    [[ $choice =~ ^[0-9]+$ ]] || return 0
    brightness_set "$choice" || return 0
    notify-send "Brightness" "$choice%" || true
}

# 输入法：fcitx5-remote 只回 1/2（英/中）和组名（keyboard-us、rime…）。
# 托盘没了以后，这里是「现在是中文还是英文」唯一的显示处（显示成 EN / ZH）。
ime() {
    local on
    on=$(fcitx5-remote 2>/dev/null) || return 0
    if [[ $on == 2 ]]; then
        printf '%s  ZH · %s\n' "$ICON_LANGUAGE" "$(fcitx5-remote -n)"
    else
        printf '%s  EN · %s\n' "$ICON_LANGUAGE" "$(fcitx5-remote -n)"
    fi
}

# 熄屏抑制：判断交给 idle-inhibit 自己（它查的就是 swayidle 读的那把锁），
# 别在这里复制一份 logind 查询逻辑。输出只认 on / off 两种，别的一律不显示。
idle() {
    case $("$dir/idle-inhibit" state 2>/dev/null) in
        on) printf '%s  on\n' "$ICON_MONITOR" ;;
        off) printf '%s  off\n' "$ICON_MONITOR" ;;
    esac
}

clock() { printf '%s  %(%m-%d %a %H:%M)T\n' "$ICON_CALENDAR" -1; }

# 工作区行：niri 的工作区号，当前所在的用方括号标出来。
#
# 本来想给当前的那个染成绿色，但 fuzzel 的正文整行只有一种字色：能上色的只有
# 「被搜索词匹配上的字符」，而匹配的字符同时决定哪些行会被留下（实测预填
# 当前工作区号会把其余读数全滤掉），两者没法兼得，只能另做个记号。
workspaces() {
    local list current numbers='' index
    local -a indices=()
    list=$(niri msg --json workspaces 2>/dev/null) || return 0
    current=$(jq -r 'map(select(.is_focused)) | .[0].idx // empty' <<< "$list")
    [[ -n $current ]] || return 0
    mapfile -t indices < <(jq -r 'sort_by(.idx) | .[].idx' <<< "$list")
    ((${#indices[@]})) || return 0

    for index in "${indices[@]}"; do
        [[ -n $numbers ]] && numbers+=' '
        if [[ $index == "$current" ]]; then
            numbers+="[$index]"
        else
            numbers+="$index"
        fi
    done
    printf '%s  %s\n' "$ICON_WORKSPACE" "$numbers"
}

# 取不到读数就整行不出现：宁可少一行，也不要一行空白占着位置。
row() {
    [[ -n $1 ]] || return 0
    printf '%s\t%s\n' "$1" "${2-}"
}

snapshot() {
    row "$(workspaces)"
    row "$(ime)" ime
    row "$(clock)"
    row "$(volume)" volume
    row "$(brightness)" brightness
    row "$(idle)" idle
    row "$(battery)"
}

# --print 只吐数据、不开窗，用来调试和核对读数。
if [[ ${1-} == --print ]]; then
    snapshot
    exit
fi

action=$(snapshot | "$dir/fuzzel-wrapper" \
    --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
    --dmenu --prompt="Status " --with-nth=1 --accept-nth=2 --only-match)

case $action in
    volume) niri msg action spawn -- pavucontrol ;;
    brightness) brightness_pick ;;
    ime) fcitx5-remote -t ;;
    idle) "$dir/idle-inhibit" toggle ;;
esac
