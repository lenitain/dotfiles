#!/bin/bash
# 状态面板的 bash 外壳：读数交给 status-readings.lua，动作分发留在 bash。
# 宽度 / 行数 / 排序 / namespace 在 ~/.config/fuzzel/status.ini。
#
# 每行两列，tab 分隔：第 1 列是读数（以图标开头），第 2 列是回车时执行的动作（可空）。
#   --with-nth=1     只显示读数列
#   --accept-nth=2   回车只回报动作名 —— 读数怎么排版、带什么空格符号，
#                    都进不了 shell，也就不需要转义
#   --only-match     打到不匹配的字符串时，回车不给「把输入原样返回」的出口
# 面板是快照，没有实时刷新：再按一次 MOD+SPACE 就是刷新（fuzzel-wrapper 先杀后开），
# 时钟也会跟着重新取值。
#
# 第一行的录制读数是个开关：REC 表示正在录，回车就停（收尾保存 MKV）；
# BUSY 表示 stop 正在收尾（或 start 正在启动），回车会等收尾结束后开新录制；
# IDLE 表示没在录，回车就选区开录。

set -u

# 不 fork dirname：niri/快捷键调用的 BASH_SOURCE 是绝对路径。
dir=${BASH_SOURCE[0]%/*}
[[ $dir == "${BASH_SOURCE[0]}" ]] && dir=.

snapshot() { "$dir/status-readings.lua"; }

# --print 只吐数据、不开窗，用来调试和核对读数。
if [[ ${1-} == --print ]]; then
    snapshot
    exit
fi

action=$(snapshot | "$dir/fuzzel-wrapper" \
    --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
    --dmenu --prompt="Status " --with-nth=1 --accept-nth=2 --only-match)

case $action in
    volume) niri msg action spawn -- pavucontrol ;;
    ime) fcitx5-remote -t ;;
    record) "$dir/record" toggle ;;
esac
