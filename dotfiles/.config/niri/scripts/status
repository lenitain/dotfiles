#!/bin/bash
# 状态面板：在 fuzzel 里看系统状态快照。取代原先「只在 overview 出现的 waybar」。
#
# 宽度 / 行数 / 排序 / namespace 这些跟用途走的项在
# ~/.config/fuzzel/status.ini（和启动器、剪贴板共用 common.ini 的主题）；
# 这里只管两件事：凑出读数，再把选中行翻译成动作。
#
# 每行两列，tab 分隔：第 1 列是读数（以图标开头），第 2 列是回车时执行的动作（可空）。
#   --with-nth=1     只显示读数列
#   --accept-nth=2   回车只回报动作名 —— 读数怎么排版、带什么空格符号，
#                    都进不了 shell，也就不需要转义
#   --only-match     打到不匹配的字符串时，回车不给「把输入原样返回」的出口
# 面板是快照，没有实时刷新：再按一次 MOD+SPACE 就是刷新（fuzzel-wrapper 先杀后开），
# 时钟也会跟着重新取值。
#
# 第一行的录制读数是个开关：REC <时长> 表示正在录，回车就停（收尾转 MP4）；
# IDLE 表示没在录，回车就选区开录。

set -u
# %a 固定英文星期：本机 locale 是中文，会输出「六」；三字母宽度稳定，
# 时间那列不会随星期长短左右跳。
export LC_TIME=C

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BAT=/sys/class/power_supply/BAT1

# 图标：Nerd Font 字形（Maple Mono NF CN 自带）。每行读数的第一个字符就是图标，
# 图标列对齐成一条竖线，扫一眼就知道这一行是什么，不用逐字读。
ICON_CLOCK=󰥔     # nf-md-clock
# 亮度图标固定就这一个（太阳）：百分比再低也不换记号 —— MDI 那套
# brightness_1..7 里 2/3 画的是月亮，绝不用；亮暗交给后面的百分数表达。
ICON_BRIGHTNESS=󰖨  # nf-md-white-balance-sunny
ICON_LANGUAGE=󰗊   # nf-md-translate
ICON_MONITOR=󰍹    # nf-md-monitor
# 录制：录着用「红点」那个记号，没录用摄像机 —— 两个图标一眼分得开
ICON_RECORD=󰑊   # nf-md-record
ICON_VIDEO=󰕧    # nf-md-video
# 工作区：3×3 的方块 —— 工作区切换器的老记号（一个方块一个工作区）
ICON_WORKSPACE=󰀻  # nf-md-apps
# 音量统一用「大声」那档图标，音量大小交给百分数表达；静音另有一个
ICON_VOLUME=󰕾
# 音量为 0（但没静音）用「喇叭不出声」那档：没有波形，也不是静音那把斜杠，
# 跟静音一眼分得开
ICON_VOLUME_ZERO=󰕿
ICON_MUTE=󰖁
# 电量五档：10 / 30 / 50 / 70 / 90，充电另有一个
ICON_BATTERY=(󰁺 󰁼 󰁾 󰂀 󰂂)
ICON_CHARGING=󰂄

# AC 适配器通没通电：sysfs 的 online。适配器名字各机不同
# （AC / AC0 / ACAD…），glob 找带 online 的那个；多路适配器任一路通电即算接通。
ac_online() {
    local file online
    for file in /sys/class/power_supply/AC*/online; do
        [[ -r $file ]] || continue
        read -r online < "$file"
        [[ $online == 1 ]] && return 0
    done
    return 1
}

# 电量：直接读 sysfs，一次 fork 都不花。
# 图标只回答「电源接没接」：插着电是带闪电的电池，没插电是电量档位 —— 两者同宽，
# 图标列的位置不随状态跳动。「在不在充」不看图标（设了充电上限时插着电也是
# Not charging），接没接电由图标自己说。
battery() {
    local cap icon
    [[ -r $BAT/capacity ]] || return 0
    read -r cap < "$BAT/capacity"
    if ac_online; then
        icon=$ICON_CHARGING
    else
        icon=${ICON_BATTERY[cap * 5 / 101]}
    fi
    printf '%s  %d%%\n' "$icon" "$cap"
}

# 音量：wpctl 一次 fork（实测 20ms；面板里真正贵的只有接外接屏时的 ddcutil detect）。
volume() {
    local out pct
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
    if [[ $out == *MUTED* ]]; then
        printf '%s  Muted\n' "$ICON_MUTE"
        return
    fi
    # "Volume: 0.36" → 36：去掉小数点就是百分数，10# 防止 036 被当八进制
    out=${out#Volume: }
    pct=$((10#${out/./}))
    if ((pct == 0)); then
        printf '%s  0%%\n' "$ICON_VOLUME_ZERO"
        return
    fi
    printf '%s  %d%%\n' "$ICON_VOLUME" "$pct"
}

# 亮度：一块屏一行，行首是 niri 的输出名。
#
# 后端各管各的屏：
#   brightnessctl — 内置屏的 sysfs backlight（amdgpu/intel…），按设备名直接读
#   ddcutil       — 外接屏的 DDC/CI（VCP 4），靠 DRM connector 认屏：
#                   detect 报 card1-HDMI-A-1，去掉 cardN- 前缀正好是 niri 的 HDMI-A-1
#
# 行序按逻辑坐标从上到下、从左到右，跟眼睛看到的桌面一致；取不到读数的屏整行不出现。
# 每行都只报读数：回车没有动作，也不弹二级面板。
brightness() {
    local -a names=() backlights=()
    local -A buses=()
    local name conn bus pct slot=0 external=0

    mapfile -t names < <(output_names)
    mapfile -t backlights < <(backlight_devices)

    # 问不到输出（niri 没起、或从别处跑 --print）就退回单行：
    # 有 backlight 还是内置屏的老样子，只是不写屏名
    if ((${#names[@]} == 0)); then
        ((${#backlights[@]})) || return 0
        pct=$(backlight_pct "${backlights[0]}") || return 0
        row "$(printf '%s  %s%%' "$ICON_BRIGHTNESS" "$pct")"
        return 0
    fi

    # 外接屏的屏号只在真有外接屏时才查：detect 要逐条 I2C 总线试过去，
    # 是这一行里最贵的一步（内屏机器上则一次都不花）
    for name in "${names[@]}"; do
        [[ $name =~ ^(eDP|LVDS|DSI) ]] || {
            external=1
            break
        }
    done
    if ((external)); then
        while IFS=$'\t' read -r conn bus; do buses[$conn]=$bus; done < <(ddc_buses)
    fi

    for name in "${names[@]}"; do
        if [[ $name =~ ^(eDP|LVDS|DSI) ]]; then
            # 内置屏按出现顺序领 backlight 设备；笔记本只有一块，多内置屏才轮得到第二块
            ((slot < ${#backlights[@]})) || continue
            pct=$(backlight_pct "${backlights[slot]}")
            slot=$((slot + 1))
        else
            pct=$(ddc_pct "${buses[$name]-}")
        fi
        [[ -n $pct ]] || continue
        row "$(printf '%s  %s%% %s' "$ICON_BRIGHTNESS" "$pct" "$name")"
    done
}

# 输出名，按逻辑位置排：先 y（上→下），同高再 x（左→右）。
output_names() {
    niri msg --json outputs 2>/dev/null | jq -r '
        to_entries
        | sort_by([(.value.logical.y // 0), (.value.logical.x // 0)])
        | .[].key'
}

# 能调的内置屏背光设备。leds 类（kbd_backlight、fnlock、numlock）不是屏，滤掉。
backlight_devices() {
    brightnessctl -m -l 2>/dev/null | awk -F, '$2 == "backlight" { print $1 }'
}

# brightnessctl 的机器可读输出：device,class,value,percentage%,max。
# 百分比自己按 value/max 算，不靠那个 percentage 字段（各版本字段数不一样）。
backlight_pct() {
    local info value max
    info=$(brightnessctl -m -d "$1" info 2>/dev/null) || return 1
    info=${info%%$'\n'*}
    value=${info#*,}
    value=${value#*,}
    value=${value%%,*}
    max=${info##*,}
    [[ $value =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || return 1
    ((max > 0)) || return 1
    printf '%d\n' "$((value * 100 / max))"
}

# DRM connector → I2C 总线，只收 DDC/CI 说得通的屏。
# 笔记本内屏会被 detect 判成 "Invalid display"（它根本没有 DDC/CI），那一块跳过。
# stdin 接 /dev/null：ddcutil 在该问用户选屏时会等输入，接了终端就卡住。
ddc_buses() {
    ddcutil detect --brief </dev/null 2>/dev/null | awk -F': *' '
        /^Invalid display/ { valid = 0; next }
        /^Display / { valid = 1; next }
        /^ *I2C bus:/ { bus = $2; sub(/[ \t]+$/, "", bus) }
        /^ *DRM connector:/ {
            conn = $2
            sub(/[ \t]+$/, "", conn)
            sub(/^card[0-9]+-/, "", conn)
            if (valid && bus != "" && conn != "") print conn "\t" bus
        }'
}

# ddcutil 的读数：VCP 4（亮度）输出 "current value = %5d, max value = %5d"。
# max 不一定是 100（有的屏 0xFFFF），所以跟 backlight 那条一样按 max 归一，
# 两条后端的百分数才是同一个语义。
ddc_pct() {
    local out value max
    [[ -n ${1-} ]] || return 1
    out=$(ddcutil getvcp 4 --bus "$1" </dev/null 2>/dev/null) || return 1
    value=${out##*current value = }
    value=${value%%,*}
    max=${out##*max value = }
    value=${value// /}
    max=${max// /}
    [[ $value =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || return 1
    ((max > 0)) || return 1
    printf '%d\n' "$((value * 100 / max))"
}

# 输入法：fcitx5-remote 只回 1/2（英/中）。
# 托盘没了以后，这里是「现在是中文还是英文」唯一的显示处（显示成 EN / ZH）。
# 组名（keyboard-us、rime…）不显示：面板要的是状态，不是输入法配置。
ime() {
    local on
    on=$(fcitx5-remote 2>/dev/null) || return 0
    if [[ $on == 2 ]]; then
        printf '%s  ZH\n' "$ICON_LANGUAGE"
    else
        printf '%s  EN\n' "$ICON_LANGUAGE"
    fi
}

# 熄屏抑制：判断交给 idle-inhibit 自己（它查的就是 swayidle 读的那把锁），
# 别在这里复制一份 logind 查询逻辑。输出只认 on / off 两种，别的一律不显示。
idle() {
    case $("$dir/idle-inhibit" state 2>/dev/null) in
        on) printf '%s  on\n' "$ICON_MONITOR" ;;
        off) printf '%s  off\n' "$ICON_MONITOR" ;;
    esac
}

# 录制状态：判断交给 record 自己（它查的就是 gsr 进程），别在这里复制一份。
# 输出 REC <时长> 或 IDLE；录制器没装时 record 不出声，这一行也就不出现。
recording() {
    local state
    state=$("$dir/record" state 2>/dev/null) || return 0
    case $state in
        REC*) printf '%s  %s\n' "$ICON_RECORD" "$state" ;;
        IDLE) printf '%s  %s\n' "$ICON_VIDEO" "$state" ;;
    esac
}

clock() { printf '%s  %(%m-%d %a %H:%M)T\n' "$ICON_CLOCK" -1; }

# 工作区行：niri 的工作区号，当前所在的用方括号标出来。
#
# 本来想给当前的那个染成绿色，但 fuzzel 的正文整行只有一种字色：能上色的只有
# 「被搜索词匹配上的字符」，而匹配的字符同时决定哪些行会被留下（实测预填
# 当前工作区号会把其余读数全滤掉），两者没法兼得，只能另做个记号。
workspaces() {
    local list current numbers='' index
    local -a indices=()
    list=$(niri msg --json workspaces 2>/dev/null) || return 0
    current=$(jq -r 'map(select(.is_focused)) | .[0].idx // empty' <<< "$list")
    [[ -n $current ]] || return 0
    mapfile -t indices < <(jq -r 'sort_by(.idx) | .[].idx' <<< "$list")
    ((${#indices[@]})) || return 0

    for index in "${indices[@]}"; do
        [[ -n $numbers ]] && numbers+=' '
        if [[ $index == "$current" ]]; then
            numbers+="[$index]"
        else
            numbers+="$index"
        fi
    done
    printf '%s  %s\n' "$ICON_WORKSPACE" "$numbers"
}

# 取不到读数就整行不出现：宁可少一行，也不要一行空白占着位置。
row() {
    [[ -n $1 ]] || return 0
    printf '%s\t%s\n' "$1" "${2-}"
}

snapshot() {
    row "$(recording)" record
    row "$(idle)" idle
    row "$(battery)"
    brightness
    row "$(volume)" volume
    row "$(ime)" ime
    row "$(workspaces)"
    row "$(clock)"
}

# --print 只吐数据、不开窗，用来调试和核对读数。
if [[ ${1-} == --print ]]; then
    snapshot
    exit
fi

action=$(snapshot | "$dir/fuzzel-wrapper" \
    --config="${XDG_CONFIG_HOME:-$HOME/.config}/fuzzel/status.ini" \
    --dmenu --prompt="Status " --with-nth=1 --accept-nth=2 --only-match)

case $action in
    volume) niri msg action spawn -- pavucontrol ;;
    ime) fcitx5-remote -t ;;
    idle) "$dir/idle-inhibit" toggle ;;
    record) "$dir/record" toggle ;;
esac
