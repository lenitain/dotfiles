# 用户级默认应用关联 — 由 xdg-mime 规范定义
# 修改：直接编辑本文件，或用 xdg-mime default <app.desktop> <mime>

[Default Applications]
# ── 网页（与你的 dotfile 中 BROWSER=qutebrowser 保持一致）──
x-scheme-handler/http=org.qutebrowser.qutebrowser.desktop
x-scheme-handler/https=org.qutebrowser.qutebrowser.desktop
text/html=org.qutebrowser.qutebrowser.desktop

# ── 文档 ──
application/pdf=org.pwmt.zathura-pdf-mupdf.desktop
application/postscript=org.pwmt.zathura-ps.desktop
text/markdown=nvim.desktop
text/plain=nvim.desktop

# ── 图片（swayimg：轻量 Wayland 看图，支持 AVIF/HEIF/JXL 等格式）──
image/png=swayimg.desktop
image/x-png=swayimg.desktop
image/jpeg=swayimg.desktop
image/jpg=swayimg.desktop
image/pjpeg=swayimg.desktop
image/gif=swayimg.desktop
image/webp=swayimg.desktop
image/svg+xml=swayimg.desktop
image/bmp=swayimg.desktop
image/x-bmp=swayimg.desktop
image/tiff=swayimg.desktop
image/avif=swayimg.desktop
image/heif=swayimg.desktop
image/jxl=swayimg.desktop
image/x-xcf=gimp.desktop

# ── 音视频（mpv，底层 ffmpeg，几乎全格式）──
# 音频
audio/mpeg=mpv.desktop
audio/mp3=mpv.desktop
audio/x-mp3=mpv.desktop
audio/aac=mpv.desktop
audio/x-aac=mpv.desktop
audio/mp4=mpv.desktop
audio/x-m4a=mpv.desktop
audio/ogg=mpv.desktop
audio/opus=mpv.desktop
audio/vorbis=mpv.desktop
audio/x-vorbis+ogg=mpv.desktop
audio/flac=mpv.desktop
audio/wav=mpv.desktop
audio/x-wav=mpv.desktop
audio/vnd.wave=mpv.desktop
audio/aiff=mpv.desktop
audio/x-aiff=mpv.desktop
audio/midi=mpv.desktop
audio/x-midi=mpv.desktop
audio/x-ape=mpv.desktop
audio/x-tta=mpv.desktop
audio/x-wavpack=mpv.desktop
audio/x-ms-wma=mpv.desktop
audio/ac3=mpv.desktop
audio/eac3=mpv.desktop
audio/amr=mpv.desktop
audio/amr-wb=mpv.desktop
audio/vnd.dts=mpv.desktop
audio/vnd.dts.hd=mpv.desktop
audio/3gpp=mpv.desktop
audio/3gpp2=mpv.desktop
audio/webm=mpv.desktop
audio/x-matroska=mpv.desktop
audio/matroska=mpv.desktop
audio/x-musepack=mpv.desktop
audio/x-mpegurl=mpv.desktop
audio/x-scpls=mpv.desktop
audio/x-speex+ogg=mpv.desktop
audio/x-adpcm=mpv.desktop
# 视频
video/mp4=mpv.desktop
video/x-m4v=mpv.desktop
video/webm=mpv.desktop
video/x-matroska=mpv.desktop
video/matroska-3d=mpv.desktop
video/matroska=mpv.desktop
video/mkv=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
video/vnd.avi=mpv.desktop
video/mpeg=mpv.desktop
video/mp2t=mpv.desktop
video/x-flv=mpv.desktop
video/x-ms-wmv=mpv.desktop
video/x-ms-asf=mpv.desktop
video/3gpp=mpv.desktop
video/3gpp2=mpv.desktop
video/ogg=mpv.desktop
video/x-ogm+ogg=mpv.desktop
video/x-theora+ogg=mpv.desktop
video/dv=mpv.desktop
video/mj2=mpv.desktop
video/x-flic=mpv.desktop
video/x-mng=mpv.desktop
video/x-ms-wmx=mpv.desktop
video/x-ms-wvxvideo=mpv.desktop
video/vnd.mpegurl=mpv.desktop
application/vnd.apple.mpegurl=mpv.desktop
application/ogg=mpv.desktop
application/x-ogg=mpv.desktop

# ── 目录：文件管理器 ──
inode/directory=yazi.desktop

# ── Office（LibreOffice）──
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop
application/msword=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop
application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop
application/vnd.openxmlformats-officedocument.presentationml.presentation=libreoffice-impress.desktop

# ── geo 链接（OpenStreetMap，隐私友好）──
x-scheme-handler/geo=openstreetmap-geo-handler.desktop
