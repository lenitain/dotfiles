{
  "collapseChangelog": true,
  "defaultModel": "MiniMax-M3.1-Flash",
  "defaultProjectTrust": "always",
  "defaultProvider": "minimax-cn",
  "defaultThinkingLevel": "max",
  "defaultTools": [
    "+codemode"
  ],
  "enableInstallTelemetry": false,
  "followUpMode": "all",
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 0,
  "lastChangelogVersion": "999.99.99",
  "markdown": {
    "mermaid": "streaming"
  },
  "npmCommand": [
    "npm",
    "--package-lock=false"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-polkit"
  ],
  "showCacheMissNotices": false,
  "showHardwareCursor": true,
  "steeringMode": "all",
  "terminal": {
    "clearOnShrink": false
  },
  "theme": "everforest-dark-medium",
  "transport": "auto",
  "treeFilterMode": "no-tools",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "quietStartup": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-polkit\",\"scope\":\"user\"}": "0.2.1"
  }
}