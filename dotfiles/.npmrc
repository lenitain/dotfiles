# npm 镜像 — 与 conf.d/mirrors.toml 的 NPM_CONFIG_REGISTRY 同源, 换镜像时两处同改。
# (node-gyp 头文件下载对应 [env] NODEJS_ORG_MIRROR; npm 11 起 disturl 属未知配置会告警, 不写)
registry=https://registry.npmmirror.com
# token 真值在 fish conf.d/npm_API_KEY.fish (按约定被 gitignore), 此处按环境变量展开。
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
