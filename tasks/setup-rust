#!/usr/bin/env bash
#MISE description="安装 Rust 工具链 (rustup + rust-analyzer)"

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"

# USTC 镜像: RUSTUP_DIST_SERVER / RUSTUP_UPDATE_ROOT 由 mise 的 [env] 注入
# (见 conf.d/mirrors.toml), mise run 的子进程继承得到, 这里不必再 export 一遍。

# ── 安装 rustup（首次安装: 硬失败, 缺工具链后续全废）──
if ! command -v rustup &>/dev/null; then
  info "安装 rustup ..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

if command -v rustup &>/dev/null; then
  ok "Rust 安装完成 ($(rustup --version | head -1))"
else
  err "Rust 安装失败"
  exit 1
fi

# ── rust-analyzer 组件（更新软失败: 失败不影响编译器本身可用）──
info "安装/更新 rust-analyzer 组件 ..."
if rustup component add rust-analyzer; then
  ok "rust-analyzer 已就绪"
else
  warn "rust-analyzer 组件安装失败 (网络/镜像不可达), 跳过"
fi

echo ""
ok "完成！Rust 工具链 + rust-analyzer 已就绪 (由 rustup/脚本管理)"
