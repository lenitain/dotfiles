#!/usr/bin/env bash
#MISE description="下载并安装 Maple Mono NL NF CN 字体到 ~/.local/share/fonts（无更新时跳过）"

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/gh.sh"

REPO="subframe7536/maple-font"
FONT_DIR="$HOME/.local/share/fonts"
MARKER="$FONT_DIR/.maplemono-version"
ASSET="MapleMonoNL-NF-CN-unhinted.zip"

# ── 前置检查（真缺依赖 → 硬失败）──
missing=()
command -v curl &>/dev/null || missing+=("curl")
command -v unzip &>/dev/null || missing+=("unzip")
command -v fc-cache &>/dev/null || missing+=("fc-cache (fontconfig)")
if [[ ${#missing[@]} -gt 0 ]]; then
  err "缺少依赖: ${missing[*]}"
  err "  → sudo pacman -S --needed curl unzip fontconfig"
  exit 1
fi

# ── 版本检测（GitHub API; 探测失败属更新失败 → 软处理, 保留现有字体）──
if ! JSON="$(gh_api "/repos/$REPO/releases/latest")"; then
  warn "无法获取最新版本信息 (网络/镜像不可用)，保留现有字体继续"
  exit 0
fi
VERSION="$(printf '%s' "$JSON" | grep -oE '"tag_name": *"[^"]+"' | head -1 | cut -d'"' -f4)"
if [[ -z "$VERSION" ]]; then
  warn "release 中未找到版本号，保留现有字体继续"
  exit 0
fi

# ── 已是最新则跳过 ──
if [[ -f "$MARKER" ]] && [[ "$(cat "$MARKER")" == "$VERSION" ]] \
   && compgen -G "$FONT_DIR/MapleMonoNL-NF-CN-*.ttf" >/dev/null; then
  info "字体已是最新 ($VERSION)，跳过"
  exit 0
fi

# ── 下载并解压（下载失败 → 软处理, 原字体未动）──
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
if ! gh_download "https://github.com/$REPO/releases/download/$VERSION/$ASSET" "$TMP/fonts.zip"; then
  warn "所有镜像均下载失败，原字体未动，跳过本次更新"
  exit 0
fi
unzip -qo "$TMP/fonts.zip" -d "$TMP/fonts"

mapfile -t found < <(find "$TMP/fonts" -name 'MapleMonoNL-NF-CN-*.ttf' -print)
if [[ ${#found[@]} -eq 0 ]]; then
  warn "zip 内未找到 MapleMonoNL-NF-CN-*.ttf，放弃安装（原字体未动）"
  exit 0
fi

# ── 安装（先清旧版，防残留）──
mkdir -p "$FONT_DIR"
rm -f "$FONT_DIR"/MapleMonoNL-NF-CN-*.ttf
cp "${found[@]}" "$FONT_DIR/"
echo "$VERSION" > "$MARKER"
fc-cache -f "$FONT_DIR" >/dev/null
ok "已安装 Maple Mono NL NF CN $VERSION ($(find "$FONT_DIR" -maxdepth 1 -name 'MapleMonoNL-NF-CN-*.ttf' | wc -l) 个文件)"
