#!/usr/bin/env bash
#MISE description="下载并安装 ECDICT 全量词典库到 ~/.local/share/stardict（无更新时跳过）"

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/gh.sh"

REPO="skywind3000/ECDICT"
DIC_DIR="$HOME/.local/share/stardict"
MARKER="$DIC_DIR/.ecdict-version"

# ── 前置检查（真缺依赖 → 硬失败）──
missing=()
command -v curl &>/dev/null || missing+=("curl")
command -v unzip &>/dev/null || missing+=("unzip")
command -v sqlite3 &>/dev/null || missing+=("sqlite3")
if [[ ${#missing[@]} -gt 0 ]]; then
  err "缺少依赖: ${missing[*]}"
  err "  → sudo pacman -S --needed curl unzip sqlite"
  exit 1
fi

# ── 版本与产物检测（GitHub API; 探测失败属更新失败 → 软处理, 保留现有词典库）──
if ! JSON="$(gh_api "/repos/$REPO/releases/latest")"; then
  warn "无法获取最新版本信息 (网络/镜像不可用)，保留现有词典库继续"
  exit 0
fi
VERSION="$(printf '%s' "$JSON" | grep -oE '"tag_name": *"[^"]+"' | head -1 | cut -d'"' -f4)"
ASSET_URL="$(printf '%s' "$JSON" | grep -oE '"browser_download_url": *"[^"]*sqlite[^"]*"' | head -1 | cut -d'"' -f4)"
if [[ -z "$VERSION" || -z "$ASSET_URL" ]]; then
  warn "release 中未找到 sqlite 产物，保留现有词典库继续"
  exit 0
fi

# ── 下载 / 安装（仅版本变化时执行; 下载失败 → 软处理）──
if [[ -f "$MARKER" ]] && [[ "$(cat "$MARKER")" == "$VERSION" ]] \
   && [[ -f "$DIC_DIR/ecdict.db" ]]; then
  info "词典库已是最新 ($VERSION)，跳过下载"
else
  TMP="$(mktemp -d)"
  trap 'rm -rf "$TMP"' EXIT
  if ! gh_download "$ASSET_URL" "$TMP/dict.zip"; then
    warn "所有镜像均下载失败，原词典库未动，跳过本次更新"
    exit 0
  fi
  unzip -qo "$TMP/dict.zip" -d "$TMP/dict"

  found="$(find "$TMP/dict" -name 'stardict.db' -print -quit)"
  if [[ -z "$found" ]]; then
    warn "zip 内未找到 stardict.db，放弃安装（原词典库未动）"
    exit 0
  fi

  # 安装（保持源库原样，表名 stardict 由 translate.sh 匹配）
  mkdir -p "$DIC_DIR"
  rm -f "$DIC_DIR/ecdict.db"
  cp "$found" "$DIC_DIR/ecdict.db"
  echo "$VERSION" > "$MARKER"
  ok "已安装 ECDICT 全量版 $VERSION ($(du -h "$DIC_DIR/ecdict.db" | cut -f1))"
fi

# ── 索引检查（独立于下载，每次运行都执行；确保 word 的 NOCASE 索引存在）──
# 本地库完整性属真实错误 → 硬失败
if [[ -f "$DIC_DIR/ecdict.db" ]]; then
  if ! has_index="$(sqlite3 "$DIC_DIR/ecdict.db" "
    SELECT COUNT(*) FROM (
      SELECT m.name FROM sqlite_master m
      JOIN pragma_index_xinfo(m.name) x
      WHERE m.type='index' AND m.tbl_name='stardict'
        AND x.seqno=0 AND x.cid>=0 AND x.name='word' AND lower(x.coll)='nocase'
      GROUP BY m.name
    );
  ")"; then
    err "读取 sqlite 索引信息失败: $DIC_DIR/ecdict.db"
    exit 1
  fi
  if [[ "$has_index" == "0" ]]; then
    info "缺少 word 索引，创建中 ..."
    if sqlite3 "$DIC_DIR/ecdict.db" "CREATE INDEX IF NOT EXISTS idx_ecdict_word_nocase ON stardict(word COLLATE NOCASE);"; then
      ok "word 索引已创建"
    else
      err "创建 word 索引失败: $DIC_DIR/ecdict.db"
      exit 1
    fi
  else
    info "word 索引已存在，跳过"
  fi
fi
