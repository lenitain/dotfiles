#!/usr/bin/env bash
#MISE description="安装 PiG coding agent + 核心扩展"

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"

if ! command -v pig &>/dev/null; then
  err "pig 未安装，请先运行: mise install"
  exit 1
fi

info "安装扩展 ..."

extensions=(
  "npm:pi-web-access"
  # 持久 Python REPL (ipykernel), 用 `pig --repl` 启用
  "npm:pi-repl-py"
)

for ext in "${extensions[@]}"; do
  info "  安装 $ext ..."
  if pig install "$ext" 2>/dev/null; then
    ok "  $ext"
  else
    warn "  $ext (已存在或跳过)"
  fi
done

echo ""
ok "PiG + 扩展已安装"

# 追最新: 扩展更新失败软处理, 保留当前版本
info "更新扩展 (pig update --extensions) ..."
if pig update --extensions; then
  ok "扩展已更新"
else
  warn "pig update --extensions 失败 (网络/远端不可达), 保留当前版本继续"
fi
