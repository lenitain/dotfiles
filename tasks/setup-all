#!/usr/bin/env bash
#MISE description="全量 sync+升级 (pacman -Syu 哲学, 单一命令追最新)"
# 前 2 步是 bootstrap(含系统升级) + 工具, 之后每个 setup-* 任务一步 (顺序见下方两个分组)。

# 单一入口: 声明式收敛 + 全量升级, 不分 setup/update。
# 哲学 = pacman -Syu: 每次执行都先全量升级再收敛。
#   - 系统升级由 mise bootstrap 的 pre-packages hook 执行 (见 conf.d/hooks.toml):
#     -Syu 恰好插在 packages 阶段前, 且 hook 失败会中止 bootstrap —— packages
#     只在「同步库不新于系统」时执行, 装缺包等价于 `pacman -Syu <包>`
#   - 命令式部分: mise upgrade(工具) → setup-* 各 sync 任务
#   - setup-boot 保持手动(带守卫); setup-desktop 为设置类(无版本语义)
#
# 失败规范: "更新/同步"类步骤一律软失败 —— 失败只 warn, 不中断后续步骤,
#   便于一次跑完尽量多的收敛; 真正缺依赖/环境不符由各任务内部 err + exit 1
#   表达, 在对应步骤的 warn 里可见。
#
# 顺序规则: 需要从 GitHub 拉取的任务统一排在最后 —— 本机/镜像类先收敛,
#   GitHub 抽风时不受影响的步骤已经做完。组内无相互依赖, 组间只保持原有相对顺序。
#   判定依据: 任务里用了 gh_api / gh_download, 或产物本身就来自 GitHub
#   (ya pkg 的插件/配色, package.toml 里是 owner/repo)。
#   例外: mise install/upgrade 里的 aqua 工具 (zls/gofumpt/golangci-lint/lua-ls/
#   stylua/ruff) 也走 GitHub, 但它同时是 setup-pig 等步骤的工具前置 (pig 由 mise
#   提供), 挪到末尾会顺序倒挂, 故留在第 2 步。

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"

# 1) 声明式收敛 + 系统全量升级。顺序安全由 hook 保证 (见 conf.d/hooks.toml):
# `-Syu` 就在 packages 阶段前, 失败会中止 bootstrap, 不会出现「库已刷新而系统
# 未升级」时还发 `pacman -S` —— 所以这里不再自己调 pacman, 避免同一次运行跑两遍。
# 失败分支补跑 --skip packages: 跳过 packages 同时跳过 hook, 全程不碰 pacman,
# 尽量把账号/文件/服务/dotfiles 收敛完 (符合"更新类失败不中断收敛"规范)。
info "[1] 声明式收敛+系统升级 (mise bootstrap → hook: sudo pacman -Syu --noconfirm) ..."
if ! mise bootstrap; then
  warn "mise bootstrap 失败 (hook 里的 -Syu 失败会在此中止)，改跑 --skip packages 继续收敛其余部分"
  if ! mise bootstrap --skip packages; then
    warn "mise bootstrap --skip packages 失败，跳过"
  fi
fi

# 2) [tools] 安装缺失 + 升级到最新
info "[2] 工具安装+升级 (mise install → mise upgrade) ..."
if ! mise install; then
  warn "mise install 失败，跳过"
fi
if ! mise upgrade; then
  warn "mise upgrade 失败，跳过"
fi

# 3) 起各 sync 任务 (已含"已最新则跳过"/"有新提交则重建"语义)
# 统一守卫: 任一步失败只 warn 并继续, 不拖死剩余步骤
# 序号自增, 不写死总数 —— 加/删任务时不用同步改别处
STEP=2
run_step() {  # run_step <任务名> <说明>
  local task="$1" desc="$2"
  STEP=$((STEP + 1))
  info "[$STEP] $task ($desc) ..."
  if ! mise run "$task"; then
    warn "$task 失败，跳过 (可单独重跑: mise run $task)"
  fi
}

# ── 非 GitHub 组: 本机设置 / 国内镜像 ──
run_step setup-desktop        "dconf/XDG"
run_step setup-rust           "rustup+rust-analyzer"
run_step setup-moonbit        "MoonBit"
run_step setup-flatpak        "flathub+apps"
run_step setup-pig            "PiG agent + 扩展"

# ── GitHub 组: 全部经 gh-proxy 拉取, 统一放最后 ──
run_step setup-fonts          "Maple Mono"
run_step setup-rime-wanxiang  "万象拼音"
run_step setup-yazi           "yazi 插件/配色"

ok "bootstrap 完成: 系统+工具+配置已同步到最新 (失败项见上方 warn)"
