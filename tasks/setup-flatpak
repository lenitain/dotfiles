#!/usr/bin/env bash
#MISE description="兜底跑 flatpak update --user (覆盖 packages.toml 声明外的手动应用)"

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/log.sh"

# 责任拆分 (单一来源原则):
#   - conf.d/packages.toml 的 6 条 flatpak-user:  → bootstrap packages apply 收敛 (声明式)
#   - conf.d/hooks.toml pre-packages 的步骤 3      → flathub 用户源 + GPG 密钥 (-Syu 之后, 硬失败)
#   - 本任务脚本                                     → 兜底 flatpak update --user, 软失败覆盖
#                                                     用户在 packages.toml 之外手动装的应用。
# 原 setup-flatpak 的「注册源 + GPG refresh + 安装循环 + 全量 update」已迁出去。
#
# 失败语义: 仍保留「flatpak 未安装 = 硬退出」的强提示, 与原脚本一致 (硬失败信号 >> 软 warn)。
# update 抽风时仅 warn, 与 setup-all 「更新/同步类步骤一律软失败」一致。

if ! command -v flatpak &>/dev/null; then
  err "flatpak 未安装 — pacman:flatpak 应由 bootstrap 装入; 若刚跑过 --skip packages, 请跑完整 mise bootstrap --yes"
  exit 1
fi

# -Syu 哲学: 有更新就更新到最新 (用户级 flathub 应用); 更新失败软处理。
# 仅覆盖声明外的应用; 声明内的 6 个会由 mise 自己 declare-update 路径管。
info "更新 flathub 应用到最新 (flatpak update --user) ..."
if flatpak update --user -y 2>&1 | tail -3; then
  ok "flathub 应用已更新"
else
  warn "flatpak update 失败 (网络/远端不可达), 保留当前版本继续"
fi

echo ""
ok "完成！重启后图标会出现在 fuzzel 中"
