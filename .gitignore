# nvim 插件锁文件
dotfiles/.config/nvim/lazy-lock.json

# 编辑器/系统杂项
.DS_Store
*.swp
*.tmp
*.log
__pycache__/

# xray-setup 私有密钥 (并入 xray/ 后不入库)
xray/host_vars/*.yml
!xray/host_vars/_template.yml

# pig 运行时 (全部默认不入库, 只 agent/ 下用户显式维护的配置入库)
dotfiles/.pig/.docs-stage.lock
dotfiles/.pig/cache/
dotfiles/.pig/docs/
dotfiles/.pig/state/
dotfiles/.pig/piglets/
dotfiles/.pig/artifacts/
dotfiles/.pig/receipts/
dotfiles/.pig/agent/auth.json
dotfiles/.pig/agent/models-store.json
dotfiles/.pig/agent/sessions/
dotfiles/.pig/agent/npm/
dotfiles/.pig/agent/pi-repl/
dotfiles/.pig/agent/web-search-cache/
dotfiles/.pig/agent/subagent-workflow/

# fish shell 变量文件 (自动生成)
dotfiles/.config/fish/fish_variables
# fish conf.d 中的 API 密钥 (按 *KEY.fish 命名约定自动忽略)
dotfiles/.config/fish/conf.d/*KEY.fish

# yazi 插件目录
dotfiles/.config/yazi/plugins/

# psd 自动生成的配置快照
dotfiles/.config/psd/.psd.conf

# Qt 文件对话框状态 (qutebrowser 运行时自动生成)
dotfiles/.config/qutebrowser/qsettings/

# 二进制脚本
dotfiles/.local/bin/scripts/qb-open

# 硬件相关显示配置
dotfiles/.config/niri/output.kdl

# jujutsu per repo info
dotfiles/.config/jj/repos
dotfiles/.config/jj/workspaces
